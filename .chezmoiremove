# Packs that moved into every runedeck repository (.dcg/packs/, skeleton
# SKEL-0009). The secret-read rule stays as a host pack (secrets.yaml),
# because it must hold outside those repositories. forge.yaml guarded a CLI
# that is no longer used; other.yaml is the host catch-all now. The tool
# policy pack is global as well as local (owner, 2026-10-24): the user copy
# carries the user.toolpolicy id, so it never collides with the rune.*
# repository packs.
.config/dcg/packs/rtk.yaml
.config/dcg/packs/homebrew.yaml
.config/dcg/packs/forge.yaml

# The global Vale layer is ~/.vale.ini with styles under ~/.vale/styles.
# These are the earlier layouts: style links at Vale's OS path that reused
# repository style names, and a short-lived ~/.config/vale/owner.ini.
Library/Application Support/vale/styles/STE
Library/Application Support/vale/styles/Deslop
Library/Application Support/vale/styles/Core
.config/vale/owner.ini
.config/vale/styles/STE
.config/vale/styles/Deslop
.config/vale/styles/Core
.config/vale/styles/config
.vale/styles/OwnerSTE
.vale/styles/OwnerDeslop
.vale/styles/OwnerCore

# The nightly prune of cargo build folders is the brew service
# N4M3Z/tap/rust-cache (forge-provision Brewfile). Its earlier dotfiles
# deployments go: target-prune, then rust-cache as a launch agent.
.local/bin/target-prune
Library/LaunchAgents/com.forge.target-prune.plist
.local/bin/rust-cache
Library/LaunchAgents/com.rune.rust-cache.plist
