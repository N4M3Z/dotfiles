# conventions; chezmoi handles their deployment without an ignore entry.

README.md
docs
tests

# Planning artifacts live in-repo only.
openspec

# The rune module manifest describes this repository, not the home folder.
defaults.yaml
module.yaml

# The SecretSpec manifest names the secrets this repository expects.
secretspec.toml

# Little Snitch reads a remote rule group from a URL, not from the home folder.
littlesnitch

# Scripts that the owner runs by hand on a Windows machine (DOT-0009).
windows

