# As with gh above: the most restrictive matched decision wins, so a broad
# ["glab"] prompt rule would override the read-only allows. Gate each
# mutating subcommand group instead.
prefix_rule(
    pattern=["glab", "api"],
    decision="prompt",
    justification="GitLab API calls can mutate remote state and require the shared policy gate.",
)
prefix_rule(
    pattern=["glab", "mr", "create"],
    decision="prompt",
    justification="Opening a merge request publishes state to the remote.",
)
prefix_rule(
    pattern=["glab", "mr", "update"],
    decision="prompt",
    justification="Updating a merge request changes remote state.",
)
prefix_rule(
    pattern=["glab", "mr", "note"],
    decision="prompt",
    justification="Notes are visible to other people and change remote state.",
)
prefix_rule(
    pattern=["glab", "mr", "approve"],
    decision="prompt",
    justification="Approving changes the approval state of a merge request.",
)
prefix_rule(
    pattern=["glab", "mr", "revoke"],
    decision="prompt",
    justification="Revoking approval changes the approval state of a merge request.",
)
prefix_rule(
    pattern=["glab", "mr", "close"],
    decision="prompt",
