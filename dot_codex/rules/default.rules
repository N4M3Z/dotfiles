    pattern=["rtk", "jj"],
    decision="prompt",
    justification="Route RTK-wrapped Jujutsu operations through auto-review because they can create commits or rewrite published history.",
)
prefix_rule(
    pattern=["trash"],
    decision="allow",
    justification="Moving files to Trash is the shared reversible-deletion path.",
)
prefix_rule(
    pattern=["rtk", "trash"],
    decision="allow",
    justification="Moving files to Trash through RTK is the shared reversible-deletion path.",
)
prefix_rule(
    pattern=["git", "push", "--force"],
    decision="forbidden",
    justification="Force-pushes rewrite published history. The ceremony forbids them.",
)
prefix_rule(
    pattern=["git", "push", "--force-with-lease"],
    decision="forbidden",
    justification="Force-pushes rewrite published history. The ceremony forbids them.",
)
prefix_rule(
    pattern=["git", "push", "-f"],
    decision="forbidden",
    justification="Force-pushes rewrite published history. The ceremony forbids them.",
)
prefix_rule(
    pattern=["sudo"],
    decision="forbidden",
    justification="Privilege escalation is never routine.",
)
prefix_rule(
    pattern=["rm", "-rf"],
    decision="forbidden",
    justification="Use trash for deletions. Recursive force deletion is not reversible.",
)
prefix_rule(
    pattern=["security"],
    decision="forbidden",
    justification="The macOS security CLI reads the keychain.",
)
prefix_rule(
    pattern=["ssh"],
    decision="forbidden",
    justification="Outbound shells leave the audited execution path.",
)
prefix_rule(
    pattern=["scp"],
    decision="forbidden",
    justification="Outbound file transfer leaves the audited execution path.",
