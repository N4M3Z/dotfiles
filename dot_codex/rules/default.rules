# gh policy: three tiers mirroring .chezmoidata/harness/claude.json.
# The most restrictive matched decision wins, so families whose subcommands
# differ are enumerated per subcommand; a broad rule would override the allows.
# Unmatched subcommands fall through to the default approval gate.
prefix_rule(
    pattern=["gh", "pr", "view"],
    decision="allow",
    justification="Read-only query of remote state.",
)
prefix_rule(
    pattern=["gh", "pr", "list"],
    decision="allow",
    justification="Read-only query of remote state.",
)
prefix_rule(
    pattern=["gh", "pr", "checks"],
    decision="allow",
    justification="Read-only query of remote state.",
)
prefix_rule(
    pattern=["gh", "pr", "diff"],
    decision="allow",
    justification="Read-only query of remote state.",
)
prefix_rule(
    pattern=["gh", "pr", "status"],
    decision="allow",
    justification="Read-only query of remote state.",
)
prefix_rule(
    pattern=["gh", "pr", "edit"],
    decision="allow",
    justification="Reversible pull-request or issue upkeep; agents run PR babysitting autonomously.",
)
prefix_rule(
    pattern=["gh", "pr", "comment"],
    decision="allow",
    justification="Reversible pull-request or issue upkeep; agents run PR babysitting autonomously.",
)
prefix_rule(
    pattern=["gh", "pr", "review"],
    decision="allow",
    justification="Reversible pull-request or issue upkeep; agents run PR babysitting autonomously.",
)
prefix_rule(
    pattern=["gh", "pr", "ready"],
    decision="allow",
    justification="Reversible pull-request or issue upkeep; agents run PR babysitting autonomously.",
)
prefix_rule(
    pattern=["gh", "pr", "close"],
    decision="allow",
    justification="Reversible pull-request or issue upkeep; agents run PR babysitting autonomously.",
)
prefix_rule(
    pattern=["gh", "pr", "reopen"],
    decision="allow",
    justification="Reversible pull-request or issue upkeep; agents run PR babysitting autonomously.",
)
prefix_rule(
    pattern=["gh", "pr", "create"],
    decision="allow",
    justification="Reversible pull-request or issue upkeep; agents run PR babysitting autonomously.",
)
prefix_rule(
    pattern=["gh", "pr", "update-branch"],
    decision="allow",
    justification="Reversible pull-request or issue upkeep; agents run PR babysitting autonomously.",
)
prefix_rule(
    pattern=["gh", "pr", "checkout"],
    decision="allow",
    justification="Local-only convenience command.",
)
prefix_rule(
    pattern=["gh", "pr", "lock"],
    decision="prompt",
    justification="Changes repository shape or publishes outward; the operator decides.",
)
prefix_rule(
    pattern=["gh", "pr", "unlock"],
    decision="prompt",
    justification="Changes repository shape or publishes outward; the operator decides.",
)
prefix_rule(
    pattern=["gh", "pr", "revert"],
    decision="prompt",
    justification="Changes repository shape or publishes outward; the operator decides.",
)
prefix_rule(
    pattern=["gh", "pr", "merge"],
    decision="forbidden",
    justification="Merges are the owner's action.",
)
prefix_rule(
    pattern=["gh", "issue", "view"],
    decision="allow",
