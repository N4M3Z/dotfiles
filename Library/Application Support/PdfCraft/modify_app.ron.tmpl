#!/bin/bash
# chezmoi modify_ script for ~/Library/Application Support/PdfCraft/app.ron.
#
# The live file arrives on stdin; stdout becomes its new contents on every
# `chezmoi apply`. PdfCraft keeps its preferences as one JSON object, stored as
# the string value "pdfcraft" in an eframe RON map beside its window and layout
# state. This script sets the managed preferences in that object. It keeps the
# other preferences, the recent files, the trusted certificates, and the window
# state. When the managed values already match, the output is the input, byte
# for byte.
#
# PdfCraft ignores a preferences object that does not parse and starts from its
# defaults, so the script stops on anything it cannot read and writes nothing.
# PdfCraft rewrites the file when it quits: apply while it is closed.
# Docs: docs/pdfcraft.md
# Source: https://github.com/N4M3Z/dotfiles
set -o pipefail

# The program goes in a variable, so that stdin stays the live file. macOS bash
# 3.2 misreads a heredoc inside $( ) when the heredoc holds an apostrophe.
# read returns 1 at the end of its input, which is expected here.
IFS= read -r -d '' program <<'PY'
import json
import string
import sys

# PdfCraft reads each preference only when its key is present, so this object
# lists only the preferences that chezmoi owns.
MANAGED = {"update_check_at_start": False}
ENTRY = "pdfcraft"
# The escapes that Rust's char::escape_debug writes, which RON uses for strings.
ESCAPES = {"\\": "\\", '"': '"', "'": "'", "n": "\n", "r": "\r", "t": "\t", "0": "\0"}


class Unreadable(Exception):
    pass


def skip_space(text, i):
    while i < len(text) and text[i] in " \t\r\n":
        i += 1
    return i


def read_string(text, i):
    """Decode the RON string literal at text[i]. Return the value and the index after it."""
    if text[i:i + 1] != '"':
        raise Unreadable("expected a string at offset %d" % i)
    out = []
    i += 1
    while i < len(text):
        char = text[i]
        if char == '"':
            return "".join(out), i + 1
        if char != "\\":
            out.append(char)
            i += 1
            continue
        escape = text[i + 1:i + 2]
        if escape and escape in ESCAPES:
            out.append(ESCAPES[escape])
            i += 2
            continue
        end = text.find("}", i + 3)
        digits = text[i + 3:end]
        if escape != "u" or text[i + 2:i + 3] != "{" or end == -1 or not 1 <= len(digits) <= 6 \
                or any(digit not in string.hexdigits for digit in digits):
            raise Unreadable("unknown escape at offset %d" % i)
        try:
            out.append(chr(int(digits, 16)))
        except ValueError:
            raise Unreadable("no such character at offset %d" % i)
        i = end + 1
    raise Unreadable("a string has no closing quote")


def write_string(value):
    """Encode value as a RON string literal. RON reads any other character as it is."""
    out = ['"']
    for char in value:
        if char in '\\"':
            out.append("\\" + char)
        elif ord(char) < 0x20 or ord(char) == 0x7F:
            out.append("\\u{" + format(ord(char), "x") + "}")
        else:
            out.append(char)
    out.append('"')
    return "".join(out)


def scan_map(text):
    """Check that text is a RON map of strings to strings.

    Return the index of the opening brace and the (start, end) span of the
    preferences literal, or None for the span when the entry is absent.
    """
    brace = skip_space(text, 0)
    if text[brace:brace + 1] != "{":
        raise Unreadable("expected a RON map")
    span = None
    i = skip_space(text, brace + 1)
    while text[i:i + 1] != "}":
        key, i = read_string(text, i)
        i = skip_space(text, i)
        if text[i:i + 1] != ":":
            raise Unreadable("expected ':' at offset %d" % i)
        start = skip_space(text, i + 1)
        _, i = read_string(text, start)
        if key == ENTRY:
            span = (start, i)
        i = skip_space(text, i)
        if text[i:i + 1] == ",":
            i = skip_space(text, i + 1)
        elif text[i:i + 1] != "}":
            raise Unreadable("expected ',' or '}' at offset %d" % i)
    if skip_space(text, i + 1) != len(text):
        raise Unreadable("unexpected text after the map")
    return brace, span


def dump(prefs):
    return json.dumps(prefs, ensure_ascii=False, separators=(",", ":"), sort_keys=True)


def already_managed(prefs):
    # bool is a subclass of int in Python, so compare the types as well.
    return all(key in prefs and type(prefs[key]) is type(value) and prefs[key] == value
               for key, value in MANAGED.items())


def modify(text):
    if not text.strip():
        return "{\n    " + write_string(ENTRY) + ": " + write_string(dump(MANAGED)) + ",\n}\n"
    brace, span = scan_map(text)
    prefs = {}
    if span is not None:
        raw, _ = read_string(text, span[0])
        try:
            prefs = json.loads(raw)
        except ValueError as error:
            raise Unreadable("the preferences are not JSON: %s" % error)
        if not isinstance(prefs, dict):
            raise Unreadable("the preferences are not a JSON object")
        if already_managed(prefs):
            return text
    prefs.update(MANAGED)
    literal = write_string(dump(prefs))
    if span is None:
        entry = "\n    " + write_string(ENTRY) + ": " + literal + ","
        return text[:brace + 1] + entry + text[brace + 1:]
    return text[:span[0]] + literal + text[span[1]:]


try:
    text = sys.stdin.buffer.read().decode("utf-8")
    sys.stdout.buffer.write(modify(text).encode("utf-8"))
except (Unreadable, UnicodeDecodeError) as error:
    sys.stderr.write("pdfcraft: %s; app.ron was not changed\n" % error)
    sys.exit(1)
PY

exec python3 -I -c "${program}"
