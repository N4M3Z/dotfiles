#!/usr/bin/env bash
# Zed Dev stores local provider credentials outside chezmoi ownership. Enforce
# private metadata after each apply without reading or copying the secret file.
{{ if eq .chezmoi.os "darwin" -}}
set -euo pipefail

credentials="$HOME/.config/zed/development_credentials"
if [[ -e "$credentials" ]]; then
    chmod 600 "$credentials"
fi
{{- end }}
