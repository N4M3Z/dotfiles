#!/usr/bin/env bash
# Pins glab's TLS trust for Proton GitLab to the system CA bundle. glab is a Go
# binary; inside a sandboxed agent shell the macOS keychain verifier cannot see
# the Proton CA and every API call fails with x509 OSStatus -26276. The system
# bundle verifies gitlab.protontech.ch fine. glab owns ~/.config/glab-cli/config.yml
# and rewrites it (update-check timestamps), so the file is not managed here and
# this script sets the one key idempotently instead. The token itself lives in
# the keychain via `glab auth login`, the same way gh keeps its token.
{{ if eq .chezmoi.os "darwin" -}}
set -euo pipefail

CONFIG="$HOME/.config/glab-cli/config.yml"

if ! command -v yq >/dev/null 2>&1; then
    echo "glab: yq missing, ca_cert not set" >&2
    exit 0
fi

if [ ! -f "$CONFIG" ]; then
    echo "glab: no config yet, run 'glab auth login --hostname gitlab.protontech.ch' first" >&2
    exit 0
fi

yq -i '.hosts["gitlab.protontech.ch"].ca_cert = "/etc/ssl/cert.pem"' "$CONFIG"
{{- end }}
