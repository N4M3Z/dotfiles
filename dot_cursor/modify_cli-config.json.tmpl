{{- if eq .chezmoi.os "windows" -}}
{{ template "harness/windows-modify" "harness/windows/cursor-cli-config" }}
{{- else -}}
#!/bin/bash
# chezmoi modify_ script for ~/.cursor/cli-config.json.
#
# The live file arrives on stdin; stdout becomes the new contents on every
# `chezmoi apply`. Only the policy fields in .chezmoidata/harness/cursor.json
# (approval mode, sandbox mode, network mode, the Shell allow and deny lists,
# and the Read deny list) are enforced. Everything the CLI writes itself
# (display, privacy cache, model choice) passes through untouched.
#
# The Shell lists derive from the Claude Bash lists, and the Read deny list from
# the Claude Read deny rules, so one edit to .chezmoidata/harness/claude.json
# changes both harnesses.
# Source: https://github.com/N4M3Z/dotfiles
set -o pipefail
umask 077

{{- /* The policy is shared with Windows: .chezmoitemplates/harness/cursor-cli-policy. */ -}}
{{- $policy := includeTemplate "harness/cursor-cli-policy" . | fromJson }}

policy=$(mktemp "${TMPDIR:-/tmp}/cursor-cli-policy.XXXXXX") || exit 1
trap 'command rm -f "$policy"' EXIT

cat > "$policy" <<'CURSOR_POLICY'
{{ $policy | toJson }}
CURSOR_POLICY

# --slurp turns empty stdin (target absent) into [] so the merge starts from {}.
jq --slurp --slurpfile policy "$policy" '((.[0] // {}) | .version = (.version // 1)) * $policy[0]'
{{ end -}}
