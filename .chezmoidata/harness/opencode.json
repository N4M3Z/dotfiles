{
  "harness": {
    "opencode": {
      "permission": {
        "*": "ask",
        "read": {
          "*": "allow",
          "*.env": "deny",
          "*.env.*": "deny",
          "*.env.example": "allow",
          "~/.ssh/**": "deny",
          "~/.aws/**": "deny",
          "~/.azure/**": "deny",
          "~/.gnupg/**": "deny",
          "~/.kube/**": "deny",
          "~/.docker/config.json": "deny",
          "~/.config/gh/**": "deny",
          "~/.config/gcloud/**": "deny",
          "~/.config/op/**": "deny",
          "~/.git-credentials": "deny",
          "~/Library/Keychains/**": "deny",
          "~/.npmrc": "deny",
          "~/.pypirc": "deny",
          "~/.gem/credentials": "deny",
          "~/.cargo/credentials.toml": "deny",
          "~/.netrc": "deny",
          "~/.password-store/**": "deny",
          "/Volumes/Keyvault/**": "deny",
          "~/Atlas/Archives/**": "deny",
          "~/Atlas/Assets/**": "deny",
          "~/Atlas/Templater/**": "deny",
          "~/Atlas/Templates/**": "deny"
        },
        "edit": {
          "*": "allow",
          "~/.bashrc": "deny",
          "~/.zshrc": "deny",
          "~/.bash_profile": "deny",
          "~/.zprofile": "deny",
          "~/.profile": "deny",
          "~/.ssh/**": "deny",
          "/Volumes/Keyvault/**": "deny"
        },
        "bash": {
          "*": "ask",
          "ls *": "allow",
          "rg *": "allow",
          "fd *": "allow",
          "wc *": "allow",
          "jq *": "allow",
          "shasum *": "allow",
          "cmp *": "allow",
          "which *": "allow",
          "mktemp *": "allow",
          "brew info *": "allow",
          "brew list *": "allow",
          "git status*": "allow",
          "git diff*": "allow",
          "git log*": "allow",
          "git show *": "allow",
          "git rev-parse *": "allow",
          "git merge-base *": "allow",
          "git rev-list *": "allow",
          "git ls-files*": "allow",
          "git branch --show-current": "allow",
          "git worktree list": "allow",
          "git fetch*": "allow",
          "git merge-tree *": "allow",
          "git commit *": "ask",
          "git push*": "ask",
          "jj log*": "allow",
          "jj st*": "allow",
          "gh pr view *": "allow",
          "gh pr list*": "allow",
          "gh pr checks *": "allow",
          "gh pr diff *": "allow",
          "gh run view *": "allow",
          "gh run list*": "allow",
          "gh issue view *": "allow",
          "gh issue list*": "allow",
          "gh repo view*": "allow",
          "gh repo list*": "allow",
          "gh auth status": "allow",
          "gh search *": "allow",
          "cargo fmt*": "allow",
          "cargo check*": "allow",
          "cargo clippy*": "allow",
          "cargo test*": "allow",
          "cargo build*": "allow",
          "actionlint*": "allow",
          "shellcheck *": "allow",
          "ruff check*": "allow",
          "semgrep scan *": "allow",
          "gitleaks git *": "allow",
          "prek run*": "allow",
          "git push --force*": "deny",
          "git push -f*": "deny",
          "git push *--force*": "deny",
          "git push * -f": "deny",
          "git push * -f *": "deny",
          "git push --delete *": "deny",
          "git push * --delete *": "deny",
          "gh pr merge*": "deny",
          "gh repo delete*": "deny",
          "gh auth token*": "deny",
          "gh auth login*": "deny",
          "gh auth refresh*": "deny",
          "sudo *": "deny",
          "dd *": "deny",
          "mkfs*": "deny",
          "diskutil erase*": "deny",
          "launchctl *": "deny",
          "security *": "deny",
          "ssh *": "deny",
          "scp *": "deny",
          "docker login*": "deny",
          "npm login*": "deny",
          "npm publish*": "deny",
          "cargo publish*": "deny",
          "open *Finder*": "deny",
          "osascript *Finder*": "deny"
        },
        "external_directory": {
          "*": "deny",
          "~/Agents/**": "allow",
          "~/Atlas/**": "allow",
          "~/Developer/**": "allow",
          "~/Data/OpenCode/**": "allow"
        },
        "webfetch": "allow",
        "websearch": "allow"
      }
    }
  }
}
