{
  "harness": {
    "codex": {
      "model_provider": "openai",
      "model_reasoning_effort": "high",
      "approval_policy": "on-request",
      "sandbox_mode": "workspace-write",
      "default_permissions": "workspace-local",
      "approvals_reviewer": "auto_review",
      "check_for_update_on_startup": false,
      "analytics": {
        "enabled": false
      },
      "tui": {
        "status_line": [
          "model-with-reasoning",
          "context-remaining",
          "five-hour-limit",
          "weekly-limit",
          "git-branch",
          "used-tokens",
          "current-dir"
        ],
        "status_line_use_colors": true
      },
      "file_opener": "none",
      "model_providers": {
        "cliproxyapi": {
          "name": "cliproxyapi",
          "base_url": "http://127.0.0.1:8317/v1",
          "wire_api": "responses",
          "auth": {
            "command": "/usr/bin/sed",
            "args": [
              "-n",
              "s/^CLIPROXY_API_KEY_CODEX=//p",
              "/Users/N4M3Z/.env"
            ]
          }
        }
      },
      "mcp_servers": {
        "gbrain": {
          "command": "/opt/homebrew/bin/bun",
          "args": [
            "/Users/N4M3Z/Developer/N4M3Z/gbrain/src/cli.ts",
            "serve"
          ],
          "env": {
            "DATABASE_URL": "postgresql://N4M3Z@localhost:5432/memex",
            "GBRAIN_MCP_PROFILE": "recall",
            "GBRAIN_STDIO_SOURCE": "__all__",
            "PATH": "/Users/N4M3Z/.bun/bin:/opt/homebrew/bin:/usr/bin:/bin"
          },
          "startup_timeout_sec": 15
        }
      },
      "permissions": {
        "workspace-local": {
          "filesystem": {
            ":root": "read",
            ":tmpdir": "write",
            ":slash_tmp": "write",
            "~/.agents": "write",
            "~/.ssh": "deny",
            "~/.aws": "deny",
            "~/.azure": "deny",
            "~/.cargo/credentials.toml": "deny",
            "~/.cache/gh": "write",
            "~/.cache/prek": "write",
            "~/.cargo/registry": "write",
            "~/.codex/skills": "write",
            "~/.config/containers": "deny",
            "~/.config/gcloud": "deny",
            "~/.config/gh": "read",
            "~/.config/op": "deny",
            "~/.docker/config.json": "deny",
            "~/.gem/credentials": "deny",
            "~/.git-credentials": "deny",
            "~/.gnupg": "deny",
            "~/.gnupg/S.gpg-agent": "write",
            "~/.gnupg/common.conf": "read",
            "~/.gnupg/gpg.conf": "read",
            "~/.gnupg/pubring.kbx": "read",
            "~/.gnupg/trustdb.gpg": "read",
            "~/.kube": "deny",
            "~/.netrc": "deny",
            "~/.npm": "deny",
            "~/.npmrc": "deny",
            "~/.password-store": "deny",
            "~/.pypirc": "deny",
            "~/Data/State/codex": "write",
            "~/Library/Caches/rune": "write",
            "~/Library/Keychains": "deny",
            "~/Library/Keychains/login.keychain-db": "read",
            ":workspace_roots": {
              ".": "write",
              ".git": "read",
              ".agents": "read",
              ".codex": "read"
            }
          },
          "network": {
            "enabled": true,
            "mode": "limited",
            "allow_local_binding": true,
            "domains": {
              "localhost": "allow",
              "127.0.0.1": "allow",
              "github.com": "allow",
              "*.github.com": "allow",
              "raw.githubusercontent.com": "allow",
              "objects.githubusercontent.com": "allow",
              "pkg-containers.githubusercontent.com": "allow",
              "registry.npmjs.org": "allow",
              "crates.io": "allow",
              "static.crates.io": "allow",
              "index.crates.io": "allow",
              "formulae.brew.sh": "allow",
              "ghcr.io": "allow",
              "pypi.org": "allow",
              "*.pypi.org": "allow",
              "files.pythonhosted.org": "allow",
              "semgrep.dev": "allow",
              "*.semgrep.dev": "allow",
              "gitlab.protontech.ch": "allow"
            }
          }
        }
      },
      "shell_environment_policy": {
        "inherit": "all",
        "exclude": [
          "*PASSWORD*",
          "*TOKEN*",
          "*SECRET*",
          "*API_KEY*"
        ],
        "set": {
          "GITLAB_HOST": "gitlab.protontech.ch",
          "GLAB_CONFIG_DIR": "/Users/N4M3Z/.config/glab-cli-agent",
          "NPM_CONFIG_CACHE": "/Users/N4M3Z/Data/State/codex/npm-cache"
        }
      }
    }
  }
}
