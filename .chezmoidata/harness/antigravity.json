{
  "harness": {
    "antigravity": {
      "enableTelemetry": true,
      "enableTerminalSandbox": true,
      "allowNonWorkspaceAccess": false,
      "toolPermission": "request-review",
      "artifactReviewPolicy": "asks-for-review",
      "permissions": {
        "allow": [
          "write_file(*)",
          "command(ls)",
          "command(pwd)",
          "command(cat)",
          "command(rg)",
          "command(grep)",
          "command(fd)",
          "command(find)",
          "command(jq)",
          "command(wc)",
          "command(which)",
          "command(shasum)",
          "command(git status)",
          "command(git diff)",
          "command(git log)",
          "command(git show)",
          "command(git fetch)",
          "command(git add)",
          "command(git commit)",
          "command(git push)",
          "command(jj log)",
          "command(jj st)",
          "command(cargo fmt)",
          "command(cargo check)",
          "command(cargo clippy)",
          "command(cargo test)",
          "command(cargo build)",
          "command(gh pr view)",
          "command(gh pr list)",
          "command(gh pr checks)",
          "command(gh pr diff)",
          "command(gh run view)",
          "command(gh run list)",
          "command(gh issue view)",
          "command(gh issue list)",
          "command(gh repo view)",
          "command(gh search)"
        ],
        "ask": [
          "command(*)",
          "unsandboxed(*)",
          "read_url(*)",
          "execute_url(*)",
          "mcp(*)",
          "command(gh api)",
          "command(gh pr edit)",
          "command(gh pr comment)",
          "command(gh pr review)",
          "command(gh pr create)",
          "command(gh run rerun)",
          "command(gh workflow run)"
        ],
        "deny": [
          "command(git push --force)",
          "command(git push -f)",
          "command(gh pr merge)",
          "command(gh repo delete)",
          "command(gh auth token)",
          "command(gh auth login)",
          "command(sd github app-token)",
          "command(rtk sd github app-token)",
          "command(sd github push)",
          "command(rtk sd github push)",
          "command(sd jj attended)",
          "command(rtk sd jj attended)",
          "command(sudo)",
          "command(rm -rf)",
          "command(security)",
          "command(ssh)",
          "command(scp)",
          "command(dd)",
          "command(launchctl)",
          "command(npm publish)",
          "command(cargo publish)",
          "command(npm login)",
          "command(docker login)",
          "read_file(.ssh/)",
          "read_file(.aws/)",
          "read_file(.gnupg/)",
          "read_file(.netrc)",
          "read_file(/Volumes/Keyvault/)",
          "write_file(.ssh/)",
          "write_file(.aws/)",
          "write_file(.gnupg/)",
          "write_file(.netrc)",
          "write_file(/Volumes/Keyvault/)",
          "write_file(/etc/)",
          "write_file(/System/)"
        ]
      }
    }
  }
}
