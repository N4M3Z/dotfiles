#!/usr/bin/env bash
# Runs on chezmoi apply whenever a forge-provision Brewfile changes (content
# hashes below), making `chezmoi apply` the one converge command for packages.
# Converges through forge-provision's brew-bundle.sh, never raw `brew bundle`:
# the wrapper trusts declared taps (Homebrew tap-trust would stall the apply),
# selects the SCOPE-correct Brewfile, and routes Mac App Store entries through
# mas-bundle.sh (missing apps only, per-app timeout) instead of Homebrew's
# unbounded mas install/upgrade handler.
# Decision: workspace docs/Setup Review.md (converge through chezmoi apply).
#
# Brewfile: {{ output "shasum" "-a" "256" (joinPath .chezmoi.homeDir "Developer/N4M3Z/forge-provision/manifests/Brewfile") | trim }}
# Brewfile.work: {{ output "sh" "-c" "if [ -f \"$1\" ]; then shasum -a 256 \"$1\"; else printf absent; fi" "sh" (joinPath .chezmoi.homeDir "Developer/N4M3Z/forge-provision/manifests/Brewfile.work") | trim }}
{{ if eq .chezmoi.os "darwin" -}}
set -euo pipefail

BUNDLE_SCRIPT="$HOME/Developer/N4M3Z/forge-provision/scripts/install/brew-bundle.sh"

if [ ! -f "$BUNDLE_SCRIPT" ]; then
    echo "run_onchange_after_brew: brew-bundle.sh not found at $BUNDLE_SCRIPT, skipping" >&2
    exit 0
fi

if ! command -v brew >/dev/null 2>&1; then
    echo "run_onchange_after_brew: brew not installed, skipping" >&2
    exit 0
fi

bash "$BUNDLE_SCRIPT"
{{- end }}
