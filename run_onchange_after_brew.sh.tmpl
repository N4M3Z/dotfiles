#!/usr/bin/env bash
# Runs on chezmoi apply whenever the forge-provision Brewfile changes (content
# hash below), making `chezmoi apply` the one converge command for packages.
# brew bundle is idempotent: installed entries are skipped, missing ones added.
# Decision: workspace docs/Setup Review.md (converge through chezmoi apply).
#
{{- $brewfile := joinPath .chezmoi.homeDir "Developer" .githubUser "forge-provision/manifests/Brewfile" -}}
# Brewfile: {{ if stat $brewfile }}{{ output "shasum" "-a" "256" $brewfile | trim }}{{ else }}absent{{ end }}
# Hashing the Brewfile is what makes chezmoi re-run this script when the manifest
# changes. The stat guard matters for portability: on a machine that has not
# cloned forge-provision the file is missing, and calling shasum on it would fail
# template rendering and take the whole `chezmoi apply` down with it.
{{ if eq .chezmoi.os "darwin" -}}
set -euo pipefail

BREWFILE="$HOME/Developer/{{ .githubUser }}/forge-provision/manifests/Brewfile"

if [ ! -f "$BREWFILE" ]; then
    echo "run_onchange_after_brew: Brewfile not found at $BREWFILE, skipping" >&2
    exit 0
fi

if ! command -v brew >/dev/null 2>&1; then
    echo "run_onchange_after_brew: brew not installed, skipping" >&2
    exit 0
fi

brew bundle --file="$BREWFILE"
{{- end }}
