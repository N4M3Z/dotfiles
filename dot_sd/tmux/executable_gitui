#!/bin/sh
# gitui popup guard: open gitui for the current directory's git repo;
# outside one, flash a status message instead of erroring inside a
# vanishing popup. Launched by clicking the git state segment.
if git rev-parse --git-dir >/dev/null 2>&1; then
    exec gitui
fi
tmux display-message "not a git repo" 2>/dev/null
exit 0
