#!/bin/sh
# Print the turn diffstat of the pane's jj repo for the tmux status
# bar: "N+ M-" for the edits since the session's prompt checkpoint
# (sd claude turn checkpoint), a bare "±" when no checkpoint exists or
# the turn is empty, nothing outside a jj repo. The scope mirrors the
# Claude Code and Codex checkpoint model: the count is the current or
# last agent turn, never the whole uncommitted working copy (a
# never-committed tree rendered 66040+ here). A trailing "⁺N" marks N
# other jj repos in the same tmux session with a non-empty turn.
# The bare glyph keeps the click target (the turn review popup)
# present at all times. Called every status-interval, so
# --ignore-working-copy avoids snapshot work and lock contention; the
# prompt and stop hooks snapshot, so the count is fresh at each turn
# boundary.
# $1 = pane path, $2 = session name (a status #() script has no client
# context, so the theme passes it). Run as: sd tmux turn diff
# CLAUDE_TURN_STATE overrides the checkpoint directory (tests).
d="$1"
sess="${2:-}"
[ -n "$d" ] || exit 0
cd "$d" 2>/dev/null || exit 0
own=$(jj root 2>/dev/null) || exit 0
[ -n "$own" ] || exit 0
tab=$(printf '\t')
state="${CLAUDE_TURN_STATE:-$HOME/.local/state/claude-turn}"

# "N+<TAB>M-" for the checkpoint-to-@ diff of the repo in $1; empty
# without a checkpoint, with an unresolvable one, or for an empty turn.
turn_stat() {
    f="$state/$(printf '%s' "$1" | tr '/' '_')"
    [ -f "$f" ] || return 0
    IFS="$tab" read -r ckpt _ < "$f"
    [ -n "$ckpt" ] || return 0
    jj -R "$1" --ignore-working-copy diff --from "$ckpt" --to @ --stat 2>/dev/null \
        | tail -1 | awk '
        /changed/ {
            plus = 0; minus = 0
            for (i = 1; i <= NF; i++) {
                if ($i ~ /^insertion/) plus = $(i - 1)
                if ($i ~ /^deletion/)  minus = $(i - 1)
            }
            if (plus + minus > 0) printf "%s+\t%s-", plus, minus
        }'
}

own_stat=$(turn_stat "$own")
if [ -n "$own_stat" ]; then
    printf '#[fg=#a6e3a1]%s#[default] #[fg=#f38ba8]%s#[default]' \
        "${own_stat%%"$tab"*}" "${own_stat#*"$tab"}"
else
    printf '±'
fi

if [ -n "$sess" ]; then
    panes=$(tmux list-panes -s -t "=$sess" -F '#{pane_current_path}' 2>/dev/null)
else
    panes=$(tmux list-panes -s -F '#{pane_current_path}' 2>/dev/null)
fi
extra=$(printf '%s\n' "$panes" | sort -u | while IFS= read -r p; do
    [ -d "$p" ] || continue
    r=$( (cd "$p" 2>/dev/null && jj root 2>/dev/null) )
    [ -n "$r" ] || continue
    [ "$r" -ef "$own" ] && continue
    printf '%s\n' "$r"
done | awk 'NF && !seen[$0]++' | while IFS= read -r r; do
    [ -n "$(turn_stat "$r")" ] && echo x
done | grep -c x)
[ "${extra:-0}" -gt 0 ] && printf ' #[fg=#f9e2af]⁺%s#[default]' "$extra"
exit 0
