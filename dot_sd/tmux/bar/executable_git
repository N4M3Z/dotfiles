#!/bin/sh
# Status-bar git segment: "git <branch>" (or short SHA when HEAD is detached,
# as jj-colocated repos leave it), with a ✗ when the worktree is dirty.
# In a jj repo the dirty check is skipped: git HEAD lags jj's @, so a ✗ there
# would be permanent noise — the jj segment owns dirty state instead.

dir=${1:-$PWD}
ref=$(git -C "$dir" symbolic-ref --short HEAD 2>/dev/null)
[ -n "$ref" ] || ref=$(git -C "$dir" rev-parse --short HEAD 2>/dev/null) || exit 0

if jj -R "$dir" root >/dev/null 2>&1; then
    printf 'git %s' "$ref"
elif [ -n "$(git -C "$dir" status --porcelain 2>/dev/null)" ]; then
    printf 'git %s ✗' "$ref"
else
    printf 'git %s' "$ref"
fi
