#!/bin/bash
# Launch an agent CLI wrapped with policy, attribution, and session capture.
#
# Invoked as `sd agent run <provider> [args...]`; the claude/codex/agy/grok/
# opencode PATH wrappers all dispatch here.
#
# Three jobs, none of which any harness does for all five on its own:
#
#   1. Session capture. Grok, Antigravity, and OpenCode expose no session
#      hooks, so the only reliable capture point is after the process exits:
#      run session-sync, and record a debt file when capture fails so
#      `verify --strict` goes red instead of silently losing the session.
#
#   2. Automated runs (HARNESS_AUTOMATED=1, councils and review jobs): pin the
#      model, force the provider's read-only/no-approval flags, and stamp any
#      commits with a jj co-author trailer naming the harness and requested
#      model, so `jj log` answers "which agent wrote this".
#
#   3. Interactive runs preserve provider defaults. All agent runs keep
#      Jujutsu signing off and use the owner's stored gh authentication.
#
# Source: https://github.com/N4M3Z/dotfiles

usage() {
    cat <<'USAGE'
Usage: sd agent run <claude|codex|antigravity|grok|opencode> [arguments...]

Interactive runs preserve provider model defaults. Set HARNESS_AUTOMATED=1 for
review automation; those runs pin the provider model and a non-interactive
read-only policy where the provider supports it.
USAGE
}

has_arg() {
    local expected="$1"
    shift
    local arg

    for arg in "$@"; do
        [[ "$arg" == "$expected" || "$arg" == "${expected}="* ]] && return 0
    done
    return 1
}

resolve_installed_binary() {
    local command_name="$1"
    local candidate
    local newest_claude_version

    case "$command_name" in
        claude)
            # shellcheck disable=SC2012 # installer-owned dir of plain version-number files
            newest_claude_version=$(ls -t "${HOME}/.local/share/claude/versions" \
                2>/dev/null | head -1)
            candidate="${HOME}/.local/share/claude/versions/${newest_claude_version}"
            [[ -n "$newest_claude_version" && -x "$candidate" ]] && echo "$candidate"
            ;;
        codex)
            candidate="${HOME}/.codex/packages/standalone/current/bin/codex"
            [[ -x "$candidate" ]] && echo "$candidate"
            ;;
        grok)
            candidate="${HOME}/.grok/bin/grok"
            [[ -x "$candidate" ]] && echo "$candidate"
            ;;
    esac
}

resolve_real_binary() {
    local command_name="$1"
    local wrapper_dir
    local clean_path=''
    local directory
    local installed_binary
    local old_ifs="$IFS"

    if [[ -n "${HARNESS_REAL_BIN_DIR:-}" \
        && -x "${HARNESS_REAL_BIN_DIR}/${command_name}" ]]; then
        echo "${HARNESS_REAL_BIN_DIR}/${command_name}"
        return 0
    fi

    wrapper_dir="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
    IFS=':'
    for directory in $PATH; do
        [[ -n "$directory" ]] || continue
        [[ "$directory" == "$wrapper_dir" ]] && continue
        [[ "$directory" == "${HOME}/.local/bin" ]] && continue
        if [[ -z "$clean_path" ]]; then
            clean_path="$directory"
        else
            clean_path="${clean_path}:${directory}"
        fi
    done
    IFS="$old_ifs"

    if PATH="$clean_path" command -v "$command_name"; then
        return 0
    fi

    installed_binary=$(resolve_installed_binary "$command_name")
    [[ -n "$installed_binary" ]] && echo "$installed_binary"
}

record_capture_debt() {
    local provider="$1"
    local provider_status="$2"
    local debt_root="${HARNESS_CAPTURE_DEBT_DIR:-${HOME}/.local/state/harness-run/capture-debt}"
    local debt_file
    local timestamp

    umask 077
    mkdir -p "$debt_root" 2>/dev/null || return 0
    timestamp=$(date -u +%Y%m%dT%H%M%SZ)
    debt_file="${debt_root}/${provider}-${timestamp}-$$.json"
    jq -n \
        --arg provider "$provider" \
        --arg cwd "$PWD" \
        --argjson provider_status "$provider_status" \
        '{
            provider: $provider,
            cwd: $cwd,
            provider_status: $provider_status,
            capture_status: "failed"
        }' > "$debt_file" 2>/dev/null || true
    chmod 600 "$debt_file" 2>/dev/null || true
}

clear_capture_debt() {
    local provider="$1"
    local debt_root="${HARNESS_CAPTURE_DEBT_DIR:-${HOME}/.local/state/harness-run/capture-debt}"

    [[ -d "$debt_root" ]] || return 0
    find "$debt_root" -type f -name "${provider}-*.json" -exec rm -f {} + 2>/dev/null || true
}

provider_label() {
    case "$1" in
        claude) echo 'Claude Code' ;;
        codex) echo 'Codex' ;;
        antigravity) echo 'Antigravity' ;;
        grok) echo 'Grok' ;;
        opencode) echo 'OpenCode' ;;
    esac
}

# Grok must not present its xAI OAuth session to CLIProxyAPI — the proxy only
# accepts its own client key. Custom-endpoint mode (GROK_MODELS_BASE_URL)
# switches Grok to bearer auth, and GROK_CODE_XAI_API_KEY scopes that bearer to
# Grok so XAI_API_KEY stays free for other tools. Exports live only in this
# process; `noproxy` (CLIPROXY_BYPASS=1) and the cliproxy off flag restore the
# direct OAuth session.
configure_grok_proxy() {
    local endpoint="${CLIPROXY_URL:-http://127.0.0.1:8317}"
    local off_flag="${CLIPROXY_OFF_FLAG:-${HOME}/.config/zsh/cliproxy.off}"
    local env_file="${CLIPROXY_ENV_FILE:-${HOME}/.env}"
    local client_key="${CLIPROXY_API_KEY:-}"

    unset GROK_CLI_CHAT_PROXY_BASE_URL

    if [[ "${CLIPROXY_BYPASS:-0}" == '1' || -e "$off_flag" ]]; then
        unset GROK_MODELS_BASE_URL GROK_CODE_XAI_API_KEY
        return 0
    fi

    if [[ -z "$client_key" && -r "$env_file" ]]; then
        client_key="$(grep '^CLIPROXY_API_KEY=' "$env_file" 2>/dev/null | cut -d= -f2-)"
    fi
    if [[ -z "$client_key" ]]; then
        printf '%s\n' \
            'sd agent run: grok routes through CLIProxyAPI but no CLIPROXY_API_KEY resolved.' \
            '              Escapes: `noproxy grok`, `cliproxy off`, or' \
            '              `touch ~/.config/zsh/cliproxy.off` where no proxy is provisioned.' >&2
        return 1
    fi

    export GROK_MODELS_BASE_URL="${endpoint}/v1"
    export GROK_CODE_XAI_API_KEY="$client_key"
}

configure_agent_environment() {
    local base_config="${XDG_CONFIG_HOME:-${HOME}/.config}/jj/config.toml"

    jj_overlay=$(mktemp "${TMPDIR:-/tmp}/harness-jj-config.XXXXXX") || return 1
    chmod 600 "$jj_overlay"
    printf '%s\n' \
        '[git]' \
        'sign-on-push = false' \
        > "$jj_overlay"

    if [[ -f "$base_config" ]]; then
        export JJ_CONFIG="${base_config}:${jj_overlay}"
    else
        export JJ_CONFIG="$jj_overlay"
    fi

    unset JJ_ATTENDED GH_TOKEN GITHUB_TOKEN
}

configure_jj_attribution() {
    local provider="$1"
    local requested_model="$2"
    local label
    local trailer

    label=$(provider_label "$provider")
    if [[ "$requested_model" == *$'\n'* \
        || "$requested_model" == *$'\r'* \
        || "$requested_model" == *'"'* \
        || "$requested_model" == *\\* \
        || "$requested_model" == *"'''"* ]]; then
        echo 'sd agent run: requested model contains unsupported attribution characters' >&2
        return 1
    fi

    trailer="Co-authored-by: ${label} / ${requested_model} <N4M3Z@users.noreply.github.com>"
    printf '%s\n' \
        '' \
        '[templates]' \
        "commit_trailers = '''\"${trailer}\"'''" \
        >> "$jj_overlay"
    export HARNESS_EXPECTED_COAUTHOR="$trailer"
}

begin_jj_change() {
    local provider="$1"
    local claimable
    local description

    command -v jj >/dev/null 2>&1 || return 0
    jj root >/dev/null 2>&1 || return 0
    claimable=$(jj log -r @ --no-graph -T 'if(empty && description == "", "yes", "no")' \
        2>/dev/null) || return 1
    if [[ "$claimable" != 'yes' ]]; then
        jj new >/dev/null || return 1
    fi
    description="WIP: $(provider_label "$provider") session $(date -u +%Y%m%dT%H%M%SZ)-$$"
    jj describe -m "$description" >/dev/null || return 1
    jj_claimed_change=$(jj log -r @ --no-graph -T 'change_id.short()' 2>/dev/null) || return 1
}

finish_jj_change() {
    local provider="$1"
    local is_empty
    local current_change

    [[ -n "${jj_claimed_change:-}" ]] || return 0
    if ! is_empty=$(jj log -r "$jj_claimed_change" --no-graph -T 'if(empty, "yes", "no")' \
        2>/dev/null); then
        echo "sd agent run: could not inspect claimed jj change ${jj_claimed_change}; WIP push gate remains active" >&2
        return 1
    fi
    if [[ "$is_empty" == 'yes' ]]; then
        jj abandon "$jj_claimed_change" >/dev/null || return 1
        return 0
    fi
    jj describe -r "$jj_claimed_change" \
        -m "chore: $(provider_label "$provider") automated session" >/dev/null || return 1
    current_change=$(jj log -r @ --no-graph -T 'change_id.short()' 2>/dev/null) || return 1
    if [[ "$current_change" == "$jj_claimed_change" ]]; then
        jj new >/dev/null || return 1
    fi
}

# tmux names windows from the pane's foreground process, which is this wrapper
# (bash) for providers that don't grab the terminal, and a version-numbered
# binary for claude's native install. Pin the window name to the provider for
# the session instead; rename-window turns automatic-rename off for the
# window, so the EXIT trap turns it back on to restore normal naming.
label_tmux_window() {
    local provider="$1"
    [[ -n "${TMUX:-}" && -n "${TMUX_PANE:-}" ]] || return 0
    command -v tmux >/dev/null 2>&1 || return 0
    tmux rename-window -t "$TMUX_PANE" "$provider" 2>/dev/null || return 0
    tmux_window_labeled=1
}

# shellcheck disable=SC2329 # Invoked by the EXIT trap.
cleanup_runner() {
    if [[ -n "${jj_overlay:-}" ]]; then
        command rm -f "$jj_overlay"
    fi
    if [[ -n "${tmux_window_labeled:-}" ]]; then
        tmux set-window-option -t "$TMUX_PANE" automatic-rename on 2>/dev/null || true
    fi
}

jj_overlay=''
jj_claimed_change=''
tmux_window_labeled=''
trap cleanup_runner EXIT

provider="${1:-}"
[[ -n "$provider" ]] && shift

case "$provider" in
    claude|codex|grok|opencode) command_name="$provider" ;;
    antigravity) command_name='agy' ;;
    -h|--help|'') usage; exit 0 ;;
    *)
        echo "sd agent run: unknown provider: ${provider}" >&2
        usage >&2
        exit 2
        ;;
esac

real_binary=$(resolve_real_binary "$command_name")
if [[ -z "$real_binary" || ! -x "$real_binary" ]]; then
    echo "sd agent run: ${command_name} is not installed outside the wrapper directory" >&2
    exit 127
fi

arguments=("$@")
automated="${HARNESS_AUTOMATED:-0}"
requested_model=''

configure_agent_environment || {
    echo 'sd agent run: could not create the agent Jujutsu policy' >&2
    exit 1
}

if [[ "$automated" == '1' ]]; then
    case "$provider" in
        claude)
            requested_model="${HARNESS_MODEL:-claude-fable-5[1m]}"
            has_arg --model "${arguments[@]}" \
                || arguments=(--model "$requested_model" "${arguments[@]}")
            ;;
        codex)
            requested_model="${HARNESS_MODEL:-gpt-5.5}"
            has_arg --model "${arguments[@]}" \
                || arguments=(--model "$requested_model" "${arguments[@]}")
            has_arg --sandbox "${arguments[@]}" \
                || arguments=(--sandbox read-only "${arguments[@]}")
            has_arg --ask-for-approval "${arguments[@]}" \
                || arguments=(--ask-for-approval never "${arguments[@]}")
            ;;
        antigravity)
            requested_model="${HARNESS_MODEL:-Gemini 3.5 Flash (High)}"
            has_arg --sandbox "${arguments[@]}" || arguments=(--sandbox "${arguments[@]}")
            has_arg --model "${arguments[@]}" \
                || arguments=(--model "$requested_model" "${arguments[@]}")
            ;;
        grok)
            requested_model="${HARNESS_MODEL:-grok-composer-2.5-fast}"
            has_arg --sandbox "${arguments[@]}" \
                || arguments=(--sandbox review-local "${arguments[@]}")
            has_arg --permission-mode "${arguments[@]}" \
                || arguments=(--permission-mode dontAsk "${arguments[@]}")
            has_arg --model "${arguments[@]}" \
                || arguments=(--model "$requested_model" "${arguments[@]}")
            ;;
        opencode)
            requested_model="${HARNESS_MODEL:-proton-lumo/lumo-max}"
            has_arg --model "${arguments[@]}" \
                || arguments=(--model "$requested_model" "${arguments[@]}")
            export OPENCODE_PERMISSION="${OPENCODE_PERMISSION:-{\"*\":\"deny\",\"read\":\"allow\",\"glob\":\"allow\",\"grep\":\"allow\",\"list\":\"allow\",\"lsp\":\"allow\",\"skill\":\"allow\"}}"
            ;;
    esac
    configure_jj_attribution "$provider" "$requested_model" || exit 1
    if ! begin_jj_change "$provider"; then
        echo 'sd agent run: could not claim an isolated jj change' >&2
        exit 1
    fi
else
    case "$provider" in
        antigravity)
            has_arg --sandbox "${arguments[@]}" || arguments=(--sandbox "${arguments[@]}")
            ;;
        grok)
            has_arg --sandbox "${arguments[@]}" \
                || arguments=(--sandbox workspace-local "${arguments[@]}")
            ;;
    esac
fi

if [[ "$provider" == 'grok' ]]; then
    configure_grok_proxy || exit 1
fi

label_tmux_window "$provider"
if [[ "$provider" == 'opencode' ]]; then
    sandbox_binary=$(resolve_real_binary codex)
    if [[ -z "$sandbox_binary" || ! -x "$sandbox_binary" ]]; then
        echo 'sd agent run: Codex is required to sandbox OpenCode' >&2
        exit 127
    fi
    "$sandbox_binary" sandbox \
        --permission-profile workspace-local \
        --cd "$PWD" \
        -- "$real_binary" "${arguments[@]}"
else
    "$real_binary" "${arguments[@]}"
fi
provider_status=$?

if [[ "$automated" == '1' ]] && ! finish_jj_change "$provider"; then
    printf '%s\n' \
        'WARNING: the harness finished, but its jj change could not be finalized.' \
        '         A WIP description remains and the push gate will reject it.' >&2
fi

session_sync="${SESSION_SYNC:-${HOME}/Developer/N4M3Z/forge-data/scripts/session-sync}"
if [[ -x "$session_sync" ]]; then
    if "$session_sync" --provider "$provider" --source wrapper </dev/null; then
        clear_capture_debt "$provider"
    else
        printf '%s\n' \
            "WARNING: ${provider} finished, but session capture failed." \
            "         The original exit status (${provider_status}) is preserved; verification will fail until capture debt is recovered." \
            >&2
        record_capture_debt "$provider" "$provider_status"
    fi
fi

exit "$provider_status"
