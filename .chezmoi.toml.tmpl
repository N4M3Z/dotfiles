{{/*
    Machine-level answers, asked once per machine by `chezmoi init` and then
    stored in ~/.config/chezmoi/chezmoi.toml. Templates read them as .name,
    .email, .workEmail, .githubUser and .machine instead of hardcoding one
    person's identity, which is what previously made these dotfiles
    single-owner.

    Non-interactive install (CI, a scripted rebuild) seeds every answer on the
    command line, so nothing blocks on a prompt. chezmoi matches a seed against
    the prompt text, not the data key, so each key below is the prompt sentence
    quoted verbatim:

        chezmoi init --apply https://github.com/N4M3Z/dotfiles.git \
            --promptString "Full name, used as the author name on commits"="Ada Lovelace" \
            --promptString "Public commit email, published in git history (a forge noreply address keeps your real mailbox private)"="ada@users.noreply.github.com" \
            --promptString "Work email, used only for repositories hosted on the work forge (blank if you have none)"="ada@example.com" \
            --promptString "Forge account name, used to build local repo paths like ~/Developer/<account>"="ada" \
            --promptChoice "Machine class, deciding which optional config deploys here"=work

    tests/validate-templates.sh seeds the same way, so it is the working
    reference if these sentences ever change.

    Identity here is for files no provisioning script writes. Git author and
    signing identity stay with forge-provision's .env and its configure
    scripts, per PROV-0008, so the two never overwrite each other.
*/ -}}
{{/*
    Each prompt states what its answer is used for, because a first run on a new
    machine is exactly when that is not obvious. chezmoi matches seeds against
    the prompt text rather than the data key, which is why the non-interactive
    form above repeats these sentences verbatim.
*/ -}}
{{- $name := promptStringOnce . "name" "Full name, used as the author name on commits" -}}
{{- $email := promptStringOnce . "email" "Public commit email, published in git history (a forge noreply address keeps your real mailbox private)" -}}
{{- $workEmail := promptStringOnce . "workEmail" "Work email, used only for repositories hosted on the work forge (blank if you have none)" "" -}}
{{- $githubUser := promptStringOnce . "githubUser" "Forge account name, used to build local repo paths like ~/Developer/<account>" -}}
{{- $machine := promptChoiceOnce . "machine" "Machine class, deciding which optional config deploys here" (list "personal" "work") -}}

[data]
    name = {{ $name | quote }}
    email = {{ $email | quote }}
    workEmail = {{ $workEmail | quote }}
    githubUser = {{ $githubUser | quote }}
    machine = {{ $machine | quote }}
