{{- /*
  ~/.claude/settings.json on Windows: the merge that
  dot_claude/modify_private_settings.json.tmpl runs with jq elsewhere. The
  shared settings replace the file, except three keys kept from it: hooks
  (rune owns them; the old ~/.sd/hook dispatcher path is repointed to
  ~/.config/just/hook), and model and outputStyle, which /model and
  /output-style write per machine.
*/ -}}
{{- $config := includeTemplate "harness/claude-settings.json" . | fromJson -}}
{{- /*
  Two environment values name macOS places. Raw API bodies go to the XDG state
  folder (created by dot_local/state/claude-code/api-bodies/.keep); the Macs
  keep ~/Data/Claude/telemetry until provision's telemetry pipeline moves.
  The extra CA is mkcert's Windows root when it exists: Node warns at every
  start about a file it cannot load.
*/ -}}
{{- $env := get $config "env" -}}
{{- $_ := set $env "OTEL_LOG_RAW_API_BODIES" (printf "file:%s/.local/state/claude-code/api-bodies" .chezmoi.homeDir) -}}
{{- $mkcert := joinPath (env "LOCALAPPDATA" | replace "\\" "/") "mkcert/rootCA.pem" | replace "\\" "/" -}}
{{- if stat $mkcert }}{{ $_ := set $env "NODE_EXTRA_CA_CERTS" $mkcert }}{{ else }}{{ $_ := unset $env "NODE_EXTRA_CA_CERTS" }}{{ end -}}
{{- $live := fromJson (includeTemplate "harness/live" (dict "text" .chezmoi.stdin "format" "json")) -}}
{{- $hooks := get $live "hooks" | default dict -}}
{{- $_ := set $config "hooks" ($hooks | toJson | replace "/.sd/hook " "/.config/just/hook " | fromJson) -}}
{{- range list "model" "outputStyle" -}}
{{-   if not (eq (get $live . | toJson) "null") }}{{ $_ := set $config . (get $live .) }}{{ end -}}
{{- end -}}
{{ toPrettyJson $config }}
