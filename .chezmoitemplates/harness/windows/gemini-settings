{{- /*
  ~/.gemini/settings.json on Windows: the policy deep-merges over the live
  file, as dot_gemini/modify_private_settings.json.tmpl does with jq elsewhere.
*/ -}}
{{- $live := fromJson (includeTemplate "harness/live" (dict "text" .chezmoi.stdin "format" "json")) -}}
{{- $policy := includeTemplate "harness/windows/paths" (dict "text" (.harness.gemini | toJson) "data" .) | fromJson -}}
{{ fromJson (includeTemplate "harness/deep-merge" (dict "a" $live "b" $policy)) | toPrettyJson }}
