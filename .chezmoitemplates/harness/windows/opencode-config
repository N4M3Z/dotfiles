{{- /*
  ~/.config/opencode/opencode.json on Windows: the policy deep-merges over the
  live file and owns the permission map outright, as
  dot_config/opencode/modify_private_opencode.json.tmpl does with jq elsewhere.
  Keys the policy does not name (provision's MCP servers and LM Studio
  provider on Apex) stay as they are.
*/ -}}
{{- $policy := .harness.opencode -}}
{{- $live := fromJson (includeTemplate "harness/live" (dict "text" .chezmoi.stdin "format" "json")) -}}
{{- $config := fromJson (includeTemplate "harness/deep-merge" (dict "a" $live "b" $policy)) -}}
{{- $_ := set $config "permission" (get $policy "permission") -}}
{{ toPrettyJson $config }}
