{{- /*
  The Cursor CLI policy as JSON, for dot_cursor/modify_cli-config.json.tmpl on
  every OS. The Shell lists derive from the Claude Bash lists and the Read deny
  list from the Claude Read deny rules, so one edit to
  .chezmoidata/harness/claude.json changes both harnesses.
*/ -}}
{{- /* Claude's legacy "cmd:*" spelling becomes Cursor's "cmd *". */ -}}
{{- $allow := list -}}
{{- range .harness.claude.permissions.allow -}}
{{- if hasPrefix "Bash(" . -}}
{{- $allow = append $allow (. | replace "Bash(" "Shell(" | replace ":*)" " *)") -}}
{{- end -}}
{{- end -}}
{{- $deny := list -}}
{{- range .harness.claude.permissions.deny -}}
{{- if hasPrefix "Bash(" . -}}
{{- $deny = append $deny (. | replace "Bash(" "Shell(" | replace ":*)" " *)") -}}
{{- end -}}
{{- /* Claude spells the home folder as ~/ and an absolute path as //. Cursor documents absolute paths. */ -}}
{{- if hasPrefix "Read(" . -}}
{{- $deny = append $deny (. | replace "Read(~/" (printf "Read(%s/" $.chezmoi.homeDir) | replace "Read(//" "Read(/") -}}
{{- end -}}
{{- end -}}
{{- merge (dict "permissions" (dict "allow" (uniq $allow) "deny" (uniq $deny))) .harness.cursor.cli | toJson -}}
