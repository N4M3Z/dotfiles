# dcg configuration, deployed by chezmoi together with the packs beside it.
# https://github.com/Dicklesworthstone/destructive_command_guard

[general]
# dcg's version is pinned by its installer; skip background update checks.
check_updates = false
# self_heal_hook stays on (its default): it idempotently re-asserts dcg's own
# PreToolUse entry if a harness drops it mid-session. The chezmoi settings
# template no longer registers hooks (it keeps the live hooks block as it is),
# and rune leaves dcg's direct entry in place, so dcg alone keeps that entry.

[packs]
# core.* (filesystem, git) is always on and cannot be disabled. system.disk is on
# by default; containers.docker is added for this machine's container workflow.
enabled = [
    "system.disk",
    "containers.docker",
]
# Custom packs auto-load from these globs (per-user, then per-project).
custom_paths = [
    "~/.config/dcg/packs/*.yaml",
    ".dcg/packs/*.yaml",
]

# Policy: a repository's .dcg.toml can only add enforcement, so a per-rule deny
# set there wins over anything below. The rules that redirect to a tool relax
# to a warning on a host where that tool is missing, so the command runs and
# the denial text still teaches the replacement. Each tool relaxes only its
# own rules: rg missing leaves the find rules enforced, yq missing leaves the
# JSON rule enforced. Where a tool exists, no entry is rendered and the rule's
# default deny holds. `lookPath` is read at `chezmoi apply`, so re-apply
# after installing or removing one of these tools. Needs dcg 0.14 or newer
# (0.5.x ignores [policy]). The rune packs themselves come from each
# repository's .dcg/packs/, loaded through custom_paths above.
[policy.rules]
{{- if not (lookPath "rg") }}
"rune.search:grep-use-rg" = "warn"
"rune.search:grep-alt-forms" = "warn"
"user.toolpolicy:grep-use-rg" = "warn"
"user.toolpolicy:grep-alt-forms" = "warn"
{{- end }}
{{- if not (lookPath "fd") }}
"rune.search:find-use-fd" = "warn"
"rune.search:find-alt-forms" = "warn"
"user.toolpolicy:find-use-fd" = "warn"
"user.toolpolicy:find-alt-forms" = "warn"
{{- end }}
{{- if not (lookPath "yq") }}
"rune.parsers:yaml-needs-yq" = "warn"
{{- end }}
{{- if not (lookPath "jq") }}
"rune.parsers:json-needs-jq" = "warn"
{{- end }}
{{- if or (not (lookPath "yq")) (not (lookPath "jq")) }}
"user.toolpolicy:yaml-json-needs-real-parser" = "warn"
{{- end }}
{{- if not (lookPath "mlr") }}
"user.toolpolicy:csv-tsv-needs-real-parser" = "warn"
{{- end }}
# sed-no-in-place has no relax entry: the redirect target is the harness
# Edit tool, which every agent context provides.

# Muse Code runs dcg as a PreToolUse hook with Claude's payload, but dcg 0.14.4
# reads that payload as Codex, because it carries a turn_id field, and its hook
# mode takes no agent override. So there is no [agents.muse] here: it would
# never apply. A future [agents.codex] binds Muse too. tests/test-muse-dcg.sh
# fails when dcg starts to tell Muse apart.

# Grok gets more packs than the other agents. dcg knows Grok from the shape of
# its hook event, so this profile applies whether dcg runs from Grok's own
# hook file (`dcg install --grok`) or from the Claude settings Grok also reads.
# On macOS no Grok setting limits a shell command's network, so the egress
# packs are the only check on uploads and tunnels. They match command text
# only: a script that opens its own connection gets past them. Grok writes
# through jj, so the strict_git rules cost it nothing. The guardrails pack
# stops Grok from weakening dcg itself (allow-once, allowlist, uninstall).
[agents.grok]
trust_level = "low"
disabled_allowlist = true
extra_packs = [
    "strict_git",
    "careful_company_running_windows.upload",
    "careful_company_running_windows.tunnel",
    "careful_company_running_windows.transfer",
    "careful_company_running_windows.chat",
    "careful_company_running_windows.email",
    "careful_company_running_windows.guardrails",
    "secret_disclosure",
    "platform.github",
    "package_managers",
    "system.permissions",
]
