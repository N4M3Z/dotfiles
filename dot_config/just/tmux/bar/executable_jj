#!/bin/sh
# Status-bar jj segment: "jj <bookmark-or-changeid>" in a Jujutsu repo,
# nothing otherwise. Dirtiness lives in the ± turn diffstat segment, so
# no marker here. --ignore-working-copy skips the snapshot on every
# status refresh (no op-log spam, no lock races with concurrent jj
# sessions).

dir=${1:-$PWD}
jj -R "$dir" root >/dev/null 2>&1 || exit 0

out=$(jj -R "$dir" --ignore-working-copy log -r @ --no-graph --color never \
    -T 'if(bookmarks, bookmarks, change_id.shortest(8))' 2>/dev/null)
[ -n "$out" ] && printf 'jj %s' "$out"
