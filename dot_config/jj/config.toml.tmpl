#:schema https://docs.jj-vcs.dev/latest/config-schema.json

[user]
name = "Martin Zeman"
email = "N4M3Z@users.noreply.github.com"

[signing]
backend = "gpg"
# "drop" keeps jj from signing every working-copy snapshot, which is especially
# inconvenient when the private key is stored on a YubiKey; git.sign-on-push
# below signs the pushed commits in one batch instead. This reduces everything
# to one touch per push, and pushed commits are still marked as "verified".
behavior = "drop"
# The key is the one git signs with. Provisioning detects it from the inserted
# YubiKey and writes it to the global git config; jj does not read git's config
# at runtime, so the value is copied in when chezmoi applies this file. With no
# key in git yet, the line is omitted and jj falls back to gpg's default key.
{{- $signingKey := output "git" "config" "--global" "--default" "" "--get" "user.signingkey" | trim }}
{{- if $signingKey }}
key = {{ $signingKey | quote }}
{{- end }}

[git]
sign-on-push = true

[aliases]
push = ["util", "exec", "--", "bash", "-c", "cd \"$(jj workspace root)\" && if [ -x .githooks/jj-push ]; then exec .githooks/jj-push \"$@\"; else exec jj git push \"$@\"; fi", "jj-push"]
# Move the nearest ancestor bookmark up to @- , ready to push.
tug = ["bookmark", "move", "--from", "closest_bookmark(@-)", "--to", "@-"]

[revset-aliases]
'closest_bookmark(to)' = 'heads(::to & bookmarks())'
