{{- $gh := lookPath "gh" | default "gh" -}}
; Git policy, chezmoi-managed at ~/.config/git/config.
;
; Git reads this file first and ~/.gitconfig second, so anything written there
; wins. That ordering is the point: forge-provision's configure scripts own
; author and signing identity and write them to ~/.gitconfig with
; `git config --global` (user.name, user.email, user.signingkey, gpg.format,
; gpg.ssh.*, commit.gpgsign, tag.gpgsign). Declaring any of those keys here
; would put two owners on one value, and whichever ran last would decide how
; commits are attributed and signed.
;
; So this file carries only settings no script writes. Identity policy that must
; hold is enforced as a check instead, by forge-provision's
; scripts/verify/identity.sh and scripts/verify/signing.sh.

[filter "lfs"]
    required = true
    clean = git-lfs clean -- %f
    smudge = git-lfs smudge -- %f
    process = git-lfs filter-process

; gh resolves at render time: the Homebrew prefix differs between Apple Silicon
; and Intel, and git runs a ! helper through the shell, where a GUI-launched
; process may carry a PATH that never finds gh.
[credential "https://github.com"]
    helper =
    helper = !{{ $gh }} auth git-credential

[credential "https://gist.github.com"]
    helper =
    helper = !{{ $gh }} auth git-credential
{{ if .workEmail }}
; Per-forge author identity. `hasconfig:remote.*.url` matches on the repo's own
; remote rather than a checkout path, so a work repo cloned anywhere on disk
; still commits as the work identity. Without this, every commit on a work forge
; carries the public noreply address from ~/.gitconfig.
[includeIf "hasconfig:remote.*.url:https://gitlab.protontech.ch/**"]
    path = ~/.config/git/work

[includeIf "hasconfig:remote.*.url:git@gitlab.protontech.ch:**"]
    path = ~/.config/git/work
{{- end }}
