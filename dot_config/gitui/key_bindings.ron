// gitui vim-style keybindings. Chezmoi-managed; canonical source at
// dotfiles/dot_config/gitui/key_bindings.ron, deploys to
// ~/.config/gitui/key_bindings.ron.
//
// Derived from the upstream vim_style_key_config.ron preset
// (https://github.com/gitui-org/gitui/blob/master/vim_style_key_config.ron),
// with the `move_left/right/up/down` overrides REMOVED so arrow keys keep
// working for list navigation. gitui's binding model is one-key-per-action
// with no fallback — overriding move_* would replace arrows entirely. By
// not overriding them, the hardcoded arrow defaults stay in effect, and
// vim shortcuts pile on top for actions that don't conflict.
//
// What you get: arrows for movement (default), plus `g`/`G` for top/bottom,
// `Ctrl+b`/`Ctrl+f` for page nav, `K`/`J` for multi-line selection, plus
// vim-style stage/unstage/stash/edit shortcuts. Help stays on `?` (we don't
// override open_help to F1).
//
// Note: if the default key layout is lower case, and you want to use
// `Shift + q` to trigger the exit event, the setting should look like
// `exit: Some(( code: Char('Q'), modifiers: "SHIFT")),` — the Char is
// upper case, the modifier is "SHIFT".
//
// See `KeysList` in src/keys/key_list.rs upstream for all possible keys.
// Every key not overwritten via this config uses the hardcoded default.

(
    // open_help intentionally NOT overridden so `?` (the gitui default) keeps
    // working. The upstream vim preset rebinds help to F(1); we keep the
    // universal `?` convention.

    // move_left/right/up/down intentionally NOT overridden so arrow keys
    // keep working as movement. gitui's binding model is one-key-per-action
    // with no fallback, so overriding to hjkl would replace arrows entirely.
    // gitui doesn't have a separate `focus_*` family; `move_*` is the
    // unified navigation action (cursor in panel + focus shift at panel
    // boundaries). To switch to hjkl, uncomment the block below; arrows
    // stop working for movement when you do.
    //
    // move_left: Some(( code: Char('h'), modifiers: "")),
    // move_right: Some(( code: Char('l'), modifiers: "")),
    // move_up: Some(( code: Char('k'), modifiers: "")),
    // move_down: Some(( code: Char('j'), modifiers: "")),

    // Tried `exit_popup: Some(( code: Left, modifiers: ""))` to make Left
    // arrow back out of diff popups alongside Escape. It backfired: Escape
    // stopped working (one-key-per-action moved exit_popup off Esc), and
    // Left arrow still triggered move_left (which wins the dispatch over
    // exit_popup), so Left arrow didn't back out either. Reverted to default.
    // If you really want a non-arrow second key for back-out, Backspace is
    // unconflicted with move_left and could be tried:
    // exit_popup: Some(( code: Backspace, modifiers: "")),

    popup_up: Some(( code: Char('p'), modifiers: "CONTROL")),
    popup_down: Some(( code: Char('n'), modifiers: "CONTROL")),
    page_up: Some(( code: Char('b'), modifiers: "CONTROL")),
    page_down: Some(( code: Char('f'), modifiers: "CONTROL")),
    home: Some(( code: Char('g'), modifiers: "")),
    end: Some(( code: Char('G'), modifiers: "SHIFT")),
    shift_up: Some(( code: Char('K'), modifiers: "SHIFT")),
    shift_down: Some(( code: Char('J'), modifiers: "SHIFT")),

    edit_file: Some(( code: Char('I'), modifiers: "SHIFT")),

    status_reset_item: Some(( code: Char('U'), modifiers: "SHIFT")),

    // undo_commit default is also Shift+U, which collides with the above
    // status_reset_item. In Staged Changes view, Shift+U fires undo-commit
    // instead of reset because both want the same key. Move undo_commit to
    // Shift+_ to free the collision. Upstream issue #2704 documents this.
    undo_commit: Some(( code: Char('_'), modifiers: "SHIFT")),

    diff_reset_lines: Some(( code: Char('u'), modifiers: "")),
    diff_stage_lines: Some(( code: Char('s'), modifiers: "")),

    stashing_save: Some(( code: Char('w'), modifiers: "")),
    stashing_toggle_index: Some(( code: Char('m'), modifiers: "")),

    stash_open: Some(( code: Char('l'), modifiers: "")),

    abort_merge: Some(( code: Char('M'), modifiers: "SHIFT")),
)
