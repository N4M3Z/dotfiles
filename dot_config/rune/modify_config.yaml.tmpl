#!/bin/bash
# chezmoi modify_ script for ~/.config/rune/config.yaml.
#
# The live file arrives on stdin; stdout becomes the new contents on every
# `chezmoi apply`. Everything below RUNE_CONFIG is enforced. The one exception
# is the `setup:` block, which `rune setup` writes into this same file to
# record completed steps; that block is preserved from the live file so a
# deploy never re-triggers first-run setup on a machine that already did it.
# Source: https://github.com/N4M3Z/dotfiles
set -o pipefail
umask 077

desired=$(mktemp "${TMPDIR:-/tmp}/rune-config.XXXXXX") || exit 1
live=$(mktemp "${TMPDIR:-/tmp}/rune-live.XXXXXX") || exit 1
trap 'command rm -f "$desired" "$live"' EXIT

cat > "$desired" <<'RUNE_CONFIG'
deck: {{ .chezmoi.homeDir }}/Developer/runedeck/deck
ontology:
    domain: Technology
    skeleton: ~/Developer/runedeck/skeleton
    vault: ~/Atlas/Domains
    lore: ~/Data
    mount: ~/Atlas
bench:
    - ~/Developer/runedeck/bench
    - ~/Developer/N4M3Z/bench
launch:
    tools:
        codex:
            binary: codex-proxy
        grok:
            # The installer puts grok outside the usual bin dirs; a caller
            # without the login shell (rune run from a job) needs the path.
            binary: {{ .chezmoi.homeDir }}/.grok/bin/grok
    models:
        sol:
            # gpt-6.1-sol as the proxy lists it (2026-10-20). The list carries no
            # context length, so this is the old gpt-5.6-sol's, assumed equal.
            id: gpt-6.1-sol
            context: 272000
        sol61:
            # Same model as sol. Kept because the council roster names sol61@codex.
            id: gpt-6.1-sol
            context: 272000
        astra:
            id: gpt-6-astra
            context: 272000
        lumo:
            id: lumo-max
            context: 131072
        lumo-opencode:
            id: proton-lumo/lumo-max
            context: 131072
        fable-main:
            id: claude-fable-5-1
            context: 200000
        fable-alt:
            id: claude-fable-5-1
            context: 200000
        grok:
            id: grok-4.7
            context: 500000
        kimi:
            id: kimi-k3
            context: 262144
        opus:
            id: claude-opus-5-5
            context: 1000000
        sonnet:
            id: claude-sonnet-5-5
            context: 200000
        gemini:
            id: gemini-4-argon-high
            context: 1000000
        # The three below are agy ids (`agy models`, 2026-10-21). agy lists no
        # context length. gemini-flash copies gemini's. opus-agy and sonnet-agy
        # copy the proxy's opus and sonnet above: same model, assumed same window.
        gemini-flash:
            id: gemini-3.8-flash-high
            context: 1000000
        opus-agy:
            id: claude-opus-5-5-high
            context: 1000000
        sonnet-agy:
            id: claude-sonnet-5-5-high
            context: 200000
    profiles:
        claude:
            sol:
                model: sol
                args:
                    - "--settings"
                    - '{"env":{"CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS":"0"}}'
                env:
                    ANTHROPIC_BASE_URL: "https://cliproxy.internal"
                    ANTHROPIC_AUTH_TOKEN:
                        from_env: CLIPROXY_API_KEY
                    ANTHROPIC_SMALL_FAST_MODEL: "gpt-6-luna"
            sol61:
                model: sol61
                args:
                    - "--settings"
                    - '{"env":{"CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS":"0"}}'
                env:
                    ANTHROPIC_BASE_URL: "https://cliproxy.internal"
                    ANTHROPIC_AUTH_TOKEN:
                        from_env: CLIPROXY_API_KEY
                    ANTHROPIC_SMALL_FAST_MODEL: "gpt-6-luna"
            lumo:
                model: lumo
                args:
                    - "--settings"
                    - '{"env":{"CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS":"0"}}'
                env:
                    ANTHROPIC_BASE_URL: "https://cliproxy.internal"
                    ANTHROPIC_AUTH_TOKEN:
                        from_env: CLIPROXY_API_KEY
                    ANTHROPIC_SMALL_FAST_MODEL: "lumo-lite"
            grok:
                model: grok
                args:
                    - "--settings"
                    - '{"env":{"CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS":"0"}}'
                env:
                    ANTHROPIC_BASE_URL: "https://cliproxy.internal"
                    ANTHROPIC_AUTH_TOKEN:
                        from_env: CLIPROXY_API_KEY
                    ANTHROPIC_SMALL_FAST_MODEL: "grok-composer-2.5-fast"
            kimi:
                model: kimi
                args:
                    - "--settings"
                    - '{"env":{"CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS":"0"}}'
                env:
                    ANTHROPIC_BASE_URL: "https://cliproxy.internal"
                    ANTHROPIC_AUTH_TOKEN:
                        from_env: CLIPROXY_API_KEY
                    ANTHROPIC_SMALL_FAST_MODEL: "kimi-k2.7-code-highspeed"
            astra:
                model: astra
                args:
                    - "--settings"
                    - '{"env":{"CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS":"0"}}'
                env:
                    ANTHROPIC_BASE_URL: "https://cliproxy.internal"
                    ANTHROPIC_AUTH_TOKEN:
                        from_env: CLIPROXY_API_KEY
                    ANTHROPIC_SMALL_FAST_MODEL: "gpt-6-luna"
            main:
                model: fable-main
                env:
                    ANTHROPIC_BASE_URL: "https://cliproxy.internal"
                    ANTHROPIC_AUTH_TOKEN:
                        from_env: CLIPROXY_API_KEY
                    ANTHROPIC_SMALL_FAST_MODEL: "claude-haiku-5-5"
            alt:
                model: fable-alt
                env:
                    ANTHROPIC_BASE_URL: "https://cliproxy.internal"
                    ANTHROPIC_AUTH_TOKEN:
                        from_env: CLIPROXY_API_KEY
                    ANTHROPIC_SMALL_FAST_MODEL: "claude-haiku-5-5"
            # The three below sit on the main proxy account, like `main`.
            fable:
                model: fable-main
                env:
                    ANTHROPIC_BASE_URL: "https://cliproxy.internal"
                    ANTHROPIC_AUTH_TOKEN:
                        from_env: CLIPROXY_API_KEY
                    ANTHROPIC_SMALL_FAST_MODEL: "claude-haiku-5-5"
            opus:
                model: opus
                env:
                    ANTHROPIC_BASE_URL: "https://cliproxy.internal"
                    ANTHROPIC_AUTH_TOKEN:
                        from_env: CLIPROXY_API_KEY
                    ANTHROPIC_SMALL_FAST_MODEL: "claude-haiku-5-5"
            sonnet:
                model: sonnet
                env:
                    ANTHROPIC_BASE_URL: "https://cliproxy.internal"
                    ANTHROPIC_AUTH_TOKEN:
                        from_env: CLIPROXY_API_KEY
                    ANTHROPIC_SMALL_FAST_MODEL: "claude-haiku-5-5"
        codex:
            sol:
                model: sol
                args:
                    - "--config"
                    - 'model="gpt-6.1-sol"'
                    - "--config"
                    - 'model_reasoning_effort="ultra"'
            sol61:
                model: sol61
                args:
                    - "--config"
                    - 'model="gpt-6.1-sol"'
                    - "--config"
                    - 'model_reasoning_effort="ultra"'
            astra:
                model: astra
                args:
                    - "--config"
                    - 'model="gpt-6-astra"'
                    - "--config"
                    - 'model_reasoning_effort="ultra"'
        opencode:
            lumo:
                model: lumo-opencode
        agy:
            # These run on the owner's Antigravity Pro quota. The Claude models
            # here are separate from the proxy's opus and sonnet.
            gemini:
                model: gemini
            flash:
                model: gemini-flash
            opus:
                model: opus-agy
            sonnet:
                model: sonnet-agy
        grok:
            # The profile is defined in ~/.grok/sandbox.toml (dot_grok/private_sandbox.toml.tmpl).
            # An explicit flag keeps headless runs sandboxed even when the wrapper is bypassed.
            # The proxy route: custom-endpoint mode switches grok to bearer auth
            # and the GROK_CODE_ key scopes that bearer to grok, so XAI_API_KEY
            # stays free. rune reads the key from ~/.env at launch; no secret here.
            grok:
                model: grok
                args:
                    - "--sandbox"
                    - "workspace-local"
                env:
                    GROK_MODELS_BASE_URL: "http://127.0.0.1:8317/v1"
                    GROK_CODE_XAI_API_KEY:
                        from_env: CLIPROXY_API_KEY
# Harness hooks, declared once (DOT-0007, cli one-dispatcher-runs-every-hook):
# every harness registers `rune hook run` per event, and these handlers run
# in order. dcg, rtk, and git-ai stay outside rune (owner, 2026-10-25): each
# keeps its own direct entry in ~/.claude/settings.json and
# ~/.codex/hooks.json, and rune's handover leaves those entries in place
# because no handler here runs the same program. Timeouts are per handler;
# the event budget and the harness's own cap clamp them. sandbox-guard (cli
# exempt-tool-is-the-whole-command) refuses a sandbox-off request for a
# command the Claude sandbox already exempts, and an exempt tool that the
# line keeps inside the sandbox, with the one command to run. It reads the
# exempt list from sandbox.excludedCommands, and a failure lets the call run.
hooks:
    version: 1
    handlers:
        - id: author-identity
          exec: [rune-hook-author-identity]
          events: [session.start]
          order: 5
          timeout_ms: 800
        - id: sandbox-guard
          exec: [rune-hook-sandbox-guard]
          events: [tool.before]
          order: 25
          timeout_ms: 500
        - id: jj-guards
          exec: [rune-hook-jj-guards]
          events: [tool.before]
          order: 30
          timeout_ms: 800
          on_failure: deny
        - id: lint-on-write
          exec: [rune-hook-lint-on-write]
          events: [tool.after]
          order: 50
          timeout_ms: 8000
        - id: turn-checkpoint
          exec: [rune-hook-turn-checkpoint]
          events: [prompt.before, turn.finish, session.end]
          order: 60
          timeout_ms: 400
        - id: tmux-status
          exec: [rune-hook-tmux-status]
          events: [prompt.before, notification, turn.finish, session.end]
          order: 70
          timeout_ms: 200
        - id: session-capture
          exec: [rune-hook-session-capture]
          events: [session.end, compact.before]
          order: 80
          timeout_ms: 300
        - id: postbox
          exec: [rune-hook-postbox]
          events: [session.start, prompt.before, turn.finish]
          order: 90
          timeout_ms: 800
RUNE_CONFIG

cat > "$live"

# yq eval-all sees both documents; copy setup across only when the live file
# has one. An empty live file (fresh machine) yields no second document.
if [ -s "$live" ] && [ "$(yq '.setup // "none"' "$live")" != "none" ]; then
    yq eval-all 'select(fileIndex == 0) * {"setup": select(fileIndex == 1).setup}' "$desired" "$live"
else
    cat "$desired"
fi
