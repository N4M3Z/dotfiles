#!/bin/bash
# chezmoi modify_ script for ~/.config/rune/config.yaml.
#
# The live file arrives on stdin; stdout becomes the new contents on every
# `chezmoi apply`. Everything below RUNE_CONFIG is enforced. The one exception
# is the `setup:` block, which `rune setup` writes into this same file to
# record completed steps; that block is preserved from the live file so a
# deploy never re-triggers first-run setup on a machine that already did it.
# Source: https://github.com/N4M3Z/dotfiles
set -o pipefail
umask 077

desired=$(mktemp "${TMPDIR:-/tmp}/rune-config.XXXXXX") || exit 1
live=$(mktemp "${TMPDIR:-/tmp}/rune-live.XXXXXX") || exit 1
trap 'command rm -f "$desired" "$live"' EXIT

cat > "$desired" <<'RUNE_CONFIG'
deck: {{ .chezmoi.homeDir }}/Developer/runedeck/deck
ontology:
    domain: Technology
    skeleton: ~/Developer/runedeck/skeleton
    vault: ~/Atlas/Domains
    lore: ~/Data
    mount: ~/Atlas
bench:
    - ~/Developer/runedeck/bench
    - ~/Developer/N4M3Z/bench
launch:
    tools:
        codex:
            binary: codex-proxy
    models:
        sol:
            id: gpt-5.6-sol
            context: 272000
        astra:
            id: gpt-6-astra
            context: 272000
        lumo:
            id: lumo-max
            context: 131072
        lumo-opencode:
            id: proton-lumo/lumo-max
            context: 131072
        fable-main:
            id: main/claude-fable-5
            context: 200000
        fable-alt:
            id: alt/claude-fable-5
            context: 200000
        grok:
            id: grok-4.7
            context: 500000
        kimi:
            id: kimi-k3
            context: 262144
        opus:
            id: claude-opus-5
            context: 200000
        sonnet:
            id: claude-sonnet-5
            context: 200000
    profiles:
        claude:
            sol:
                model: sol
                args:
                    - "--settings"
                    - '{"env":{"CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS":"0"}}'
                env:
                    ANTHROPIC_BASE_URL: "https://cliproxy.internal"
                    ANTHROPIC_AUTH_TOKEN:
                        from_env: CLIPROXY_API_KEY
                    ANTHROPIC_SMALL_FAST_MODEL: "gpt-5.6-luna"
            lumo:
                model: lumo
                args:
                    - "--settings"
                    - '{"env":{"CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS":"0"}}'
                env:
                    ANTHROPIC_BASE_URL: "https://cliproxy.internal"
                    ANTHROPIC_AUTH_TOKEN:
                        from_env: CLIPROXY_API_KEY
                    ANTHROPIC_SMALL_FAST_MODEL: "lumo-lite"
            grok:
                model: grok
                args:
                    - "--settings"
                    - '{"env":{"CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS":"0"}}'
                env:
                    ANTHROPIC_BASE_URL: "https://cliproxy.internal"
                    ANTHROPIC_AUTH_TOKEN:
                        from_env: CLIPROXY_API_KEY
                    ANTHROPIC_SMALL_FAST_MODEL: "grok-composer-2.5-fast"
            kimi:
                model: kimi
                args:
                    - "--settings"
                    - '{"env":{"CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS":"0"}}'
                env:
                    ANTHROPIC_BASE_URL: "https://cliproxy.internal"
                    ANTHROPIC_AUTH_TOKEN:
                        from_env: CLIPROXY_API_KEY
                    ANTHROPIC_SMALL_FAST_MODEL: "kimi-k2.7-code-highspeed"
            sol-run:
                model: sol
                env:
                    ANTHROPIC_BASE_URL: "https://cliproxy.internal"
                    ANTHROPIC_AUTH_TOKEN:
                        from_env: CLIPROXY_API_KEY
                    ANTHROPIC_SMALL_FAST_MODEL: "gpt-5.6-luna"
            astra:
                model: astra
                args:
                    - "--settings"
                    - '{"env":{"CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS":"0"}}'
                env:
                    ANTHROPIC_BASE_URL: "https://cliproxy.internal"
                    ANTHROPIC_AUTH_TOKEN:
                        from_env: CLIPROXY_API_KEY
                    ANTHROPIC_SMALL_FAST_MODEL: "gpt-5.6-luna"
            lumo-run:
                model: lumo
                env:
                    ANTHROPIC_BASE_URL: "https://cliproxy.internal"
                    ANTHROPIC_AUTH_TOKEN:
                        from_env: CLIPROXY_API_KEY
                    ANTHROPIC_SMALL_FAST_MODEL: "lumo-lite"
            main:
                model: fable-main
                env:
                    ANTHROPIC_BASE_URL: "https://cliproxy.internal"
                    ANTHROPIC_AUTH_TOKEN:
                        from_env: CLIPROXY_API_KEY
                    ANTHROPIC_SMALL_FAST_MODEL: "main/claude-haiku-4-5-20251001"
            alt:
                model: fable-alt
                env:
                    ANTHROPIC_BASE_URL: "https://cliproxy.internal"
                    ANTHROPIC_AUTH_TOKEN:
                        from_env: CLIPROXY_API_KEY
                    ANTHROPIC_SMALL_FAST_MODEL: "alt/claude-haiku-4-5-20251001"
        codex:
            sol:
                model: sol
                args:
                    - "--config"
                    - 'model="gpt-5.6-sol"'
                    - "--config"
                    - 'model_reasoning_effort="ultra"'
            astra:
                model: astra
                args:
                    - "--config"
                    - 'model="gpt-6-astra"'
                    - "--config"
                    - 'model_reasoning_effort="ultra"'
        opencode:
            lumo:
                model: lumo-opencode
        grok:
            # The profile is defined in ~/.grok/sandbox.toml (dot_grok/private_sandbox.toml.tmpl).
            # An explicit flag keeps headless runs sandboxed even when the wrapper is bypassed.
            grok:
                model: grok
                args:
                    - "--sandbox"
                    - "workspace-local"
RUNE_CONFIG

cat > "$live"

# yq eval-all sees both documents; copy setup across only when the live file
# has one. An empty live file (fresh machine) yields no second document.
if [ -s "$live" ] && [ "$(yq '.setup // "none"' "$live")" != "none" ]; then
    yq eval-all 'select(fileIndex == 0) * {"setup": select(fileIndex == 1).setup}' "$desired" "$live"
else
    cat "$desired"
fi
