{{/*
    editor::AddReviewComment exists only in a locally built Zed, so a stock
    build rejects the whole keymap section it appears in. Create the marker file
    ~/.config/zed/.custom-build on a machine running the custom build to include
    those bindings; every other machine renders the keymap without them.
*/ -}}
{{- $customBuild := stat (joinPath .chezmoi.homeDir ".config/zed/.custom-build") -}}
[
    {
        // Space-leader bindings, vim-style. VimControl scopes them to
        // normal/visual modes; !menu keeps space usable in completions.
        "use_key_equivalents": true,
        "context": "VimControl && !menu",
        "bindings": {
            "space space": "file_finder::Toggle",
            // Television picker in a centered modal; cmd-p stays the native
            // finder (spans all open worktrees).
            "space f": ["task::Spawn", { "task_name": "Fuzzy find file (tv)", "reveal_target": "center" }],
            "space e": "project_panel::ToggleFocus",
            "space g": "git_panel::ToggleFocus",
            "space o": "outline::Toggle",
            "space v": ["task::Spawn", { "task_name": "Open note in Obsidian" }],
            "space b": "editor::FindAllReferences",
            "space p s": "project_symbols::Toggle",
            "space m p": "markdown::OpenPreviewToTheSide",
            "space m r": "repl::Run",
            "space m w": "settings_profile_selector::Toggle",
            "space m c": "workspace::ToggleCenteredLayout",
            "space m f": "markdown::OpenFollowingPreview",
            "space m t": "editor::ToggleSoftWrap",
            "space a a": "agent::ToggleFocus",
            "space a s": "agent::AddSelectionToThread",
            "space a t": "multi_workspace::ToggleWorkspaceSidebar",
            "space a n": "agent::NewTerminalThread",
            "space a r": "editor::SendReviewToAgent",
            "space a c": "editor::ToggleReviewCommentsExpanded",
            // Review annotations: y clips all markers as tuicr markdown, p
            // shows them all in project search. The marker popup on "space a m"
            // needs a locally built Zed, so it lives in the segment at the end.
            "space a y": ["task::Spawn", { "task_name": "Clip review comments" }],
            "space a p": ["pane::DeploySearch", { "query": "\\[(NOTE|SUGGESTION|ISSUE|PRAISE)\\] ", "regex": true }],
            "space n t": "agent::NewTerminalThread",
            "space n c": ["agent::NewExternalAgentThread", { "agent": "claude-acp" }],
            "space n x": ["agent::NewExternalAgentThread", { "agent": "codex-acp" }],
            "space n o": ["agent::NewExternalAgentThread", { "agent": "opencode" }],
            "space n m": "agent::ToggleNewThreadMenu",
            "space r": ["task::Spawn", { "task_name": "Review current file (tuicr)", "reveal_target": "center" }],
            "space r w": ["task::Spawn", { "task_name": "Review working tree (tuicr)", "reveal_target": "center" }],
            "space t g": ["task::Spawn", { "task_name": "gitui", "reveal_target": "center" }],
            "space t d": ["task::Spawn", { "task_name": "sabiql", "reveal_target": "center" }],
            "space t j": ["task::Spawn", { "task_name": "jjui", "reveal_target": "center" }],
            "space c": ["task::Spawn", { "task_name": "Shellcheck current file" }],
            "space s g": ["task::Spawn", { "task_name": "Scan for secrets (gitleaks)" }],
            "space m g": ["task::Spawn", { "task_name": "Render markdown (glow)", "reveal_target": "center" }],
            "space k": ["task::Spawn", { "task_name": "Recall selection (memex)", "reveal_target": "center" }]
        }
    },
    {
        // Threads Sidebar on a plain-cmd chord, completing the j-family
        // (cmd-j bottom dock, cmd-alt-j sidebar). Workspace covers panels;
        // the Editor entry shadows JoinLines, which vim's J already covers.
        "use_key_equivalents": true,
        "context": "Workspace",
        "bindings": {
            "cmd-shift-j": "multi_workspace::ToggleWorkspaceSidebar",
            // Terminal toggle on cmd-` (macOS assigns it to app window cycling
            // by default; inside Zed this binding wins, and window cycling
            // stays on the Window menu). ctrl-` remains Zed's default.
            "cmd-`": "terminal_panel::Toggle",
            // New Terminal Thread directly — cmd-n reuses the last-used thread
            // type, and the type picker (cmd-alt-shift-n) is easy to miss.
            // ProjectPanel keeps its own cmd-alt-n (NewDirectory).
            "cmd-alt-n": "agent::NewTerminalThread"
        }
    },
    {
        // Any-quote/any-bracket text objects (ciq, cib, and cs variants):
        // lowercase = traditional innermost-first matching, uppercase =
        // mini.ai current-line-first with tree-sitter awareness.
        "use_key_equivalents": true,
        "context": "vim_operator == a || vim_operator == i || vim_operator == cs",
        "bindings": {
            "q": "vim::AnyQuotes",
            "b": "vim::AnyBrackets",
            "Q": "vim::MiniQuotes",
            "B": "vim::MiniBrackets"
        }
    },
    {
        "use_key_equivalents": true,
        "context": "Editor",
        "bindings": {
            "cmd-shift-j": "multi_workspace::ToggleWorkspaceSidebar"
        }
    },
    {
        // Cycle agent threads without opening the sidebar. Brackets are the
        // prev/next convention; cmd-alt is the threads layer (cmd-alt-j =
        // sidebar). The Editor entry shadows Fold/UnfoldLines, which vim's
        // z-fold commands already cover.
        "use_key_equivalents": true,
        "context": "Workspace",
        "bindings": {
            "cmd-alt-[": "multi_workspace::PreviousThread",
            "cmd-alt-]": "multi_workspace::NextThread"
        }
    },
    {
        "use_key_equivalents": true,
        "context": "Editor",
        "bindings": {
            "cmd-alt-[": "multi_workspace::PreviousThread",
            "cmd-alt-]": "multi_workspace::NextThread"
        }
    }{{ if $customBuild }},

    // Custom-build segment. Everything below binds an action that ships only in
    // a locally built Zed, so a stock build rejects the entire section it sits
    // in. Keeping it as one trailing segment means a stock machine drops these
    // sections whole and every binding above stays untouched.
    {
        "use_key_equivalents": true,
        "context": "VimControl && !menu",
        "bindings": {
            // Review annotation popup: m opens the marker popup on the selection.
            "space a m": "editor::AddReviewComment"
        }
    },
    {
        "use_key_equivalents": true,
        "context": "Editor",
        "bindings": {
            // Review annotation popup on any buffer: cmd-k is Zed's chord prefix.
            "cmd-k c": "editor::AddReviewComment"
        }
    }{{ end }}
]
