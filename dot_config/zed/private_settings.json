{
  // Managed by chezmoi (dot_config/zed in the dotfiles repo). After GUI
  // tweaks, capture with: chezmoi re-add. Baseline for fresh machines:
  // forge-provision manifests/zed/ (seeded by scripts/configure/zed.sh)
  // Zed parses JSONC; keep jq away from this file or strip comments first.
  "markdown_preview_font_size": 16.0,
  "agent_ui_font_size": 16.0,
  "bottom_dock_layout": "right_aligned",
  "soft_wrap": "editor_width",
  // Format only git-modified lines on save; needs a 1.12+ build (sd zed rebuild).
  // "format_on_save": "modifications",
  "allow_rewrap": "in_comments",
  "preferred_line_length": 120,
  "show_wrap_guides": false,
  "outline_panel": {
    "dock": "left",
  },
  "diagnostics": {
    "inline": {
      "enabled": true,
    },
  },
  "icon_theme": {
    "mode": "system",
    "light": "Zed (Default)",
    "dark": "Zed (Default)",
  },
  "ui_font_family": ".SystemUIFont",
  "buffer_line_height": "comfortable",
  "buffer_font_size": 16.0,
  "buffer_font_family": "MesloLGSDZ Nerd Font",
  // Markdown preview typography.
  "markdown_preview_font_family": "Atkinson Hyperlegible Next",
  "markdown_preview_code_font_family": "MesloLGS Nerd Font Mono",
  "proxy": "",
  "agent": {
    "dock": "right",
    // Terminal threads attach the directory's tmux session (create it empty if
    // absent), so a Zed restart reattaches. No agent is launched here: windows
    // come from tmux-continuum restore + claude-revive, or you open them.
    // `sd tmux session-name` resolves the name: reuse a live session by
    // candidate names (folder name first), else the canonical derivation.
    "terminal_init_command": "tmux new-session -A -s \"$(sd tmux session-name)\"",
    "sidebar_side": "right",
    // Use the full panel width; the default caps content at 850px centered.
    "limit_content_width": false,
    "default_model": { "provider": "ollama", "model": "qwen2.5-coder:7b" },
    "inline_assistant_model": {
      "provider": "omlx",
      "model": "Qwen3-Coder-Next-MLX-4bit",
    },
    "favorite_models": [],
    "model_parameters": [],
  },

  // Local Ollama provider for Inline Assist. context_window lifts Ollama's
  // 4096 default so larger selections are not truncated.
  "language_models": {
    "ollama": {
      "api_url": "http://localhost:11434",
      "context_window": 32768,
    },
    // Local MLX provider on :8000. The provider id is lowercase so Zed's
    // derived key env var is OMLX_API_KEY — Zed uppercases <id>_API_KEY with
    // word-boundary splitting, so an "oMLX" id would look for O_MLX_API_KEY.
    // `name` must match a served model id exactly (GET :8000/v1/models).
    "openai_compatible": {
      "omlx": {
        "api_url": "http://localhost:8000/v1",
        "available_models": [
          {
            "name": "gpt-oss-20b-MXFP4-Q8",
            "display_name": "gpt-oss 20B (oMLX)",
            "max_tokens": 32768,
            "capabilities": {
              "tools": true,
              "images": false,
              "parallel_tool_calls": false,
              "prompt_cache_key": false,
            },
          },
          {
            "name": "gemma-4-26B-A4B-it-QAT-MLX-4bit",
            "display_name": "Gemma 4 26B (oMLX)",
            "max_tokens": 32768,
            "capabilities": {
              "tools": false,
              "images": false,
              "parallel_tool_calls": false,
              "prompt_cache_key": false,
            },
          },
          {
            "name": "Qwen3-Coder-Next-MLX-4bit",
            "display_name": "Qwen3-Coder-Next (oMLX)",
            "max_tokens": 32768,
            "capabilities": {
              "tools": true,
              "images": false,
              "parallel_tool_calls": false,
              "prompt_cache_key": false,
            },
          },
        ],
      },
    },
  },

  // Temporary Markdown Focus profile, selected via the settings profile
  // selector (`space m w`); deselecting restores the base user settings.
  "profiles": {
    "Markdown Focus": {
      "base": "user",
      "settings": {
        "buffer_font_family": "Atkinson Hyperlegible Mono",
        "buffer_font_fallbacks": ["MesloLGS Nerd Font Mono"],
        "buffer_font_size": 17.0,
        "buffer_line_height": "comfortable",
        "current_line_highlight": "gutter",
        "tab_bar": {
          "show": false,
        },
        "toolbar": {
          "breadcrumbs": false,
        },
        "minimap": {
          "show": "never",
        },
        "gutter": {
          "line_numbers": false,
          "runnables": false,
          "bookmarks": false,
          "breakpoints": false,
          "folds": false,
          "min_line_number_digits": 2,
        },
        "diagnostics": {
          "inline": {
            "enabled": false,
          },
        },
        "inlay_hints": {
          "enabled": false,
        },
      },
    },
  },

  // REPL kernels for `space m r` (repl::Run on fenced blocks). Plain Jupyter
  // kernelspecs on the machine, not Zed extensions; refresh with
  // `repl: refresh kernelspecs` after changes.
  "jupyter": {
    "kernel_selections": {
      "python": "zed-python",
      "typescript": "deno",
      "bash": "bash",
      "shell script": "bash"
    }
  },

  "cli_default_open_behavior": "existing_window",
  "autosave": "on_focus_change",

  "project_panel": {
    "bold_folder_labels": true,
    "scrollbar": {
      "show": "system",
    },
    "dock": "left",
  },

  // Predictions ride the default provider (Zeta); they activate after
  // the one-time Zed sign-in. Data collection stays declined. A local FIM
  // provider ("open_ai_compatible_api" + prompt_format against oMLX
  // /v1/completions) is possible but multi-second on Apple Silicon.
  "edit_predictions": {
    "provider": "zed",
    "allow_data_collection": "no",
  },

  "session": {
    "trust_all_worktrees": true,
  },

  "theme": {
    "mode": "system",
    "light": "Catppuccin Latte",
    "dark": "Catppuccin Mocha",
  },

  // Per-theme overrides (keyed by theme name). Mocha gets a near-neutral #202024
  // editor background (a whisper of Catppuccin's blue tint) with darker chrome and
  // lighter elevated surfaces. Both themes get a brighter terminal red so Claude
  // Code's tool-call output reads in the built-in terminal, plus red bold
  // (emphasis.strong) and mauve italic (emphasis) in markdown. Zed renders ANSI
  // bold as font weight only, so red and bright_red are kept equal for
  // consistency, not because bold remaps to bright.
  "theme_overrides": {
    "Catppuccin Latte": {
      "terminal.ansi.red": "#d20f39",
      "terminal.ansi.bright_red": "#e64553",
      "terminal.bright_foreground": "#d20f39",
      "syntax": {
        "emphasis.strong": { "color": "#d20f39", "font_weight": 700 },
        "emphasis": { "color": "#8839ef", "font_style": "italic" },
      },
    },
    "Catppuccin Mocha": {
      "background": "#19191d",
      "editor.background": "#202024",
      "editor.gutter.background": "#202024",
      "editor.active_line.background": "#2a2a2e",
      "elevated_surface.background": "#26262a",
      "surface.background": "#19191d",
      "panel.background": "#19191d",
      "tab_bar.background": "#19191d",
      "tab.active_background": "#202024",
      "tab.inactive_background": "#19191d",
      "title_bar.background": "#19191d",
      "status_bar.background": "#19191d",
      "toolbar.background": "#202024",
      "terminal.background": "#202024",
      "terminal.ansi.red": "#ff5555",
      "terminal.ansi.bright_red": "#ff5555",
      "terminal.bright_foreground": "#ff5555",
      "syntax": {
        "emphasis.strong": { "color": "#ff5555", "font_weight": 700 },
        "emphasis": { "color": "#cba6f7", "font_style": "italic" },
      },
    },
  },

  "vim_mode": true,
  "relative_line_numbers": "disabled",
  "cursor_blink": false,

  "inlay_hints": {
    "enabled": true,
  },

  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },

  // Claude Code in the agent panel over ACP, declared here so no
  // per-machine registry step. Auth and model choice stay with
  // Claude Code itself.
  "agent_servers": {
    "glm-acp-agent": {
      "type": "registry",
    },
    "github-copilot-cli": {
      "type": "registry",
    },
    "claude-acp": {
      "default_config_options": {
        "mode": "auto"
      },
      "type": "registry",
    },
    "pi-acp": {
      "type": "registry",
    },
    "opencode": {
      "type": "registry",
    },
    "codex-acp": {
      "type": "registry",
    },
  },

  // gbrain (local knowledge brain) as an MCP context server, so the Zed
  // agent can search the vault. Reaches the Zed-native agent and, via ACP
  // forwarding, Zed-hosted Claude Code. Terminal threads and the standalone
  // cmux fallback use Claude Code's own MCP config instead. Env mirrors the
  // gbrain serve command (Ollama embedder + local Postgres).
  "context_servers": {
    "gbrain": {
      "command": "/Users/N4M3Z/.bun/bin/gbrain",
      "args": ["serve"],
      "env": {
        "OPENAI_BASE_URL": "http://localhost:11434/v1",
        "OPENAI_API_KEY": "ollama",
        "DATABASE_URL": "postgresql://localhost:5432/memex",
        "GBRAIN_STDIO_SOURCE": "atlas",
      },
    },
  },

  // Nerd font so prompt glyphs render in the built-in terminal.
  // Mono variant to match Ghostty (p10k canonical, single-cell glyphs).
  // draw_bold_text_with_bright_colors (fork patch): bold cells with no
  // explicit color render in terminal.bright_foreground — this is what makes
  // Claude Code's markdown bold red in terminal threads.
  "terminal": {
    "font_size": 15.0,
    "copy_on_select": true,
    // Cmd-click opens URLs even while claude/tmux have mouse reporting on.
    "open_links_in_mouse_mode": true,
    "draw_bold_text_with_bright_colors": true,
    // minimum_contrast 0: the contrast pass would shift bright_foreground's red.
    "minimum_contrast": 0,
    "scrollbar": {
      "show": "system",
    },
    "font_family": "MesloLGS Nerd Font Mono",
  },

  // Centered text column for long-form writing; toggle via the command
  // palette ("toggle centered layout").
  "centered_layout": {
    "left_padding": 0.15,
    "right_padding": 0.15,
  },

  // Give odd-named files real syntax highlighting.
  "file_types": {
    "Ruby": ["Brewfile", "Brewfile.optional"],
    "env": [".env", ".env.*"],
  },

  // Declarative extension install, applied on startup. Every id is
  // verified against zed-industries/extensions.
  "auto_install_extensions": {
    "catppuccin": true,
    "nord": true,
    "html": true,
    "toml": true,
    "make": true,
    "dockerfile": true,
    "docker-compose": true,
    "sql": true,
    "env": true,
    "markdown-oxide": true,
    // Harper (harper-ls): offline grammar/style checking alongside oxide.
    "harper": true,
    // Code-aware spelling (identifier-splitting), the half Harper doesn't do.
    "codebook": true,
    // Typst diagnostics + live compile (tinymist).
    "typst": true,
    // Mermaid diagrams in markdown.
    "mermaid": true,
    // Inline dependency versions in manifests (Cargo.toml etc.).
    "dependi": true,
    "jq": true,
    "kdl": true,
    "git-firefly": true,
    "csv": true,
    "lua": true,
    "basher": true,
  },
  "languages": {
    "Markdown": {
      "indent_guides": {
        "enabled": false,
      },
    },
  },
}
