#!/bin/bash
# chezmoi modify_ script for ~/.gemini/antigravity-cli/settings.json.
#
# How chezmoi runs this: the CURRENT live file arrives on stdin, and whatever
# this script prints to stdout becomes the file's new contents on every
# `chezmoi apply`. That makes the file partially managed: the policy fields
# declared in .chezmoidata/harness/antigravity.json are enforced, while
# everything the app writes itself stays untouched.
#
# The template expression below embeds the policy JSON at render
# time; jq then deep-merges it over the live config.
# Source: https://github.com/N4M3Z/dotfiles
umask 077

policy=$(mktemp "${TMPDIR:-/tmp}/antigravity-policy.XXXXXX") || exit 1
trap 'command rm -f "$policy"' EXIT

{{/* This repository is public, so it does not record where the private folder lives. Antigravity has no recursive wildcard, so the path is found at render time. */ -}}
{{ $dotfilesPrivate := glob "Developer/*/dotfiles-private" | first | default "dotfiles-private" -}}
{{/* Antigravity matches a rule path as written, so the policy data writes ~/ and the home folder is filled in at render time. */ -}}
cat > "$policy" <<'FORGE_POLICY'
{{ .harness.antigravity | toJson | replace "(~/" (printf "(%s/" .chezmoi.homeDir) | replace "@DOTFILES_PRIVATE@" $dotfilesPrivate }}
FORGE_POLICY

# --slurp reads an absent live file as an empty list. A live file that does not
# parse stops jq, so the apply fails and the file stays as it is.
jq --slurp --slurpfile policy "$policy" '(.[0] // {}) * $policy[0]'
