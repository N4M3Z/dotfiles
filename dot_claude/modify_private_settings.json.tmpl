{{- /* Permission policy is shared: edit .chezmoidata/harness/claude.json, not this block. */ -}}
{{- $harness := .harness.claude -}}
#!/bin/sh
# A modify script: chezmoi hands the live settings.json on stdin and takes
# the new file from stdout. Everything but `hooks` comes from the template
# below; `hooks` is kept from the live file as it is, because rune owns
# that block (cli change harness-hook-dispatch, DOT-0007): `rune hook
# install` writes one dispatcher entry per event and keeps every foreign
# entry. Nothing here registers a hook, so a chezmoi apply never undoes
# what rune wrote. Until that rune change ships, the live entries run
# `sh ~/.config/just/hook <Event>`, the dispatcher in the just tree.
# `model` and `outputStyle` are also kept from the live file: /model and
# /output-style write them per machine, and the template sets neither.
set -eu
live=$(cat)
[ -n "$live" ] || live='{}'
desired=$(cat <<'DESIRED'
{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "cleanupPeriodDays": 36500,
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "BASH_DEFAULT_TIMEOUT_MS": "180000",
    "BASH_MAX_TIMEOUT_MS": "900000",
    "CLAUDE_CODE_SUBPROCESS_ENV_SCRUB": "1",
    "DATABASE_URL": "postgresql://localhost:5432/memex",
    "CLAUDE_CODE_ENABLE_TELEMETRY": "1",
    "CLAUDE_CODE_ENHANCED_TELEMETRY_BETA": "1",
    "OTEL_METRICS_EXPORTER": "otlp",
    "OTEL_LOGS_EXPORTER": "otlp",
    "OTEL_TRACES_EXPORTER": "none",
    "OTEL_EXPORTER_OTLP_PROTOCOL": "http/protobuf",
    "OTEL_EXPORTER_OTLP_ENDPOINT": "http://localhost:4318",
    "OTEL_EXPORTER_OTLP_METRICS_TEMPORALITY_PREFERENCE": "cumulative",
    "OTEL_METRIC_EXPORT_INTERVAL": "60000",
    "OTEL_LOG_USER_PROMPTS": "1",
    "OTEL_LOG_TOOL_DETAILS": "1",
    "OTEL_METRICS_INCLUDE_SESSION_ID": "true",
    {{- /*
    The Seatbelt sandbox blocks the keychain lookup (trustd), so a sandboxed
    harness cannot verify the mkcert certificate that cliproxy.internal
    serves (probed 2026-10-20). This file is the mkcert trust root: with it,
    Node verifies the proxy beside its built-in roots. The variable only
    adds a root and removes none.
    */}}
    "NODE_EXTRA_CA_CERTS": "{{ .chezmoi.homeDir }}/Library/Application Support/mkcert/rootCA.pem",
    "GITLAB_HOST": "{{ .private.gitlab_host }}"
  },
  "permissions": {{ $harness.permissions | toPrettyJson }},
  "attribution": {
    "commit": "Co-Authored-By: Martin Zeman <N4M3Z@users.noreply.github.com>",
    "pr": ""
  },
  "enableAllProjectMcpServers": false,
  "statusLine": {
    "type": "command",
    "command": "{{ .chezmoi.homeDir }}/.bun/bin/ccline",
    "padding": 0
  },
  "enabledPlugins": {
    "warp@claude-code-warp": false,
    "superwhisper@superwhisper": false,
    "terminal-browser@terminal-browser": true,
    "filetree@n4m3z": true,
    "review@runedeck": true,
    "spec@runedeck": true,
    "proof@runedeck": true,
    "sign@runedeck": true,
    "draft@runedeck": true,
    "hook@runedeck": true,
    "council@runedeck": true,
    "tasks@runedeck": true,
    "jj@runedeck": true,
    "replay@runedeck": true,
    "doc-review@runedeck": true,
    "flightdeck@runedeck": true,
    "vale-lsp@runedeck": true,
    "blast-radius@runedeck": true,
    "cc-plugin-you-should-know@builtin": true
  },
  "extraKnownMarketplaces": {
    "claude-code-warp": {
      "source": {
        "source": "github",
        "repo": "warpdotdev/claude-code-warp"
      }
    },
    "superwhisper": {
      "source": {
        "source": "github",
        "repo": "superultrainc/superwhisper-claude-code"
      }
    },
    "terminal-browser": {
      "source": {
        "source": "github",
        "repo": "zenbu-labs/terminal-browser"
      }
    },
    "n4m3z": {
      "source": {
        "source": "directory",
        "path": "{{ .chezmoi.homeDir }}/Developer/N4M3Z/filetree"
      }
    },
    "runedeck": {
      "source": {
        "source": "directory",
        "path": "{{ .chezmoi.homeDir }}/Developer/runedeck/mods"
      }
    }
  },
  {{- /*
  allowUnsandboxedCommands stays true on purpose (2026-09-22). The sandbox
  denies what the signing and forge ceremony needs: the YubiKey pinentry and
  gpg-agent for `jj sign`, the keychain for `gh` over TLS, a nested sandbox
  for `grok` and `codex`, and the jj lock files of a colocated repo. `trash`
  is not on that list: ~/.local/bin/trash writes the FreeDesktop layout under
  ~/.local/share/Trash, which allowWrite covers, so it runs sandboxed. With this false, every such step fails with -26276 or
  "Operation not permitted" and the owner runs it by hand. With it true a
  session may ask for one command outside the sandbox; the request still goes
  through the permission prompt. The `Bash(dangerouslyDisableSandbox:true)`
  allow rule below matches command text, not the request flag, so it grants
  nothing on its own. Known limit: a session that lies in the request text
  is not stopped here. dcg and the permission prompt are the guard.
  */}}
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": true,
    "autoAllowBashIfSandboxed": true,
    "network": {
      "allowedDomains": [
        "github.com",
        "*.github.com",
        "raw.githubusercontent.com",
        "objects.githubusercontent.com",
        "pkg-containers.githubusercontent.com",
        "registry.npmjs.org",
        "crates.io",
        "static.crates.io",
        "index.crates.io",
        "formulae.brew.sh",
        "ghcr.io",
        "pypi.org",
        "*.pypi.org",
        "files.pythonhosted.org",
        "semgrep.dev",
        "*.semgrep.dev",
        "browserbase.com",
        "*.browserbase.com",
        "{{ .private.gitlab_host }}",
        "localhost",
        "127.0.0.1",
        "cliproxy.internal",
        "lumo.proton.me",
        "models.opencode.ai"
      ],
      "allowUnixSockets": [
        "/tmp/.s.PGSQL.5432",
        "~/.obsidian-cli.sock",
        "~/.gnupg/S.gpg-agent",
        "~/.gnupg/S.dirmngr"
      ],
      "allowLocalBinding": true
    },
    "filesystem": {
      "allowWrite": [
        "~/Agents",
        "~/.cache/uv",
        "~/.cache/act",
        "~/.cache/prek",
        {{- /*
        Cargo's download cache, shared with unsandboxed builds. Without it a
        sandboxed build stops at the first crate it must download (EPERM on
        registry/cache, probed 2026-10-22), and sessions worked around that
        with private CARGO_HOME copies that download everything again. The
        rest of ~/.cargo stays closed: bin is on PATH, and config.toml can
        name a rustc wrapper that an unsandboxed build would run.
        Cargo's two lock files follow, under names cargo hard-codes
        (src/util/cache_lock.rs). .package-cache is the download lock: cargo
        holds it alone while it downloads crates. .package-cache-mutate is the
        cleanup lock: every build shares it, and cache cleanup holds it alone.
        Without them a sandboxed cargo falls back to a shared lock, which does
        not keep two sandboxed downloads apart. With them cargo queues them
        ("Blocking waiting for file lock on package cache", probed 2026-10-24). The last-use record
        (.global-cache) stays closed. SQLite needs to create files beside it.
        */}}
        "~/.cargo/registry",
        "~/.cargo/git",
        "~/.cargo/.package-cache",
        "~/.cargo/.package-cache-mutate",
        "~/.local/share/Trash",
        "~/.local/state/rune",
        "~/.local/state/sd-job",
        "/tmp/claude",
        "/var/folders",
        "~/Atlas",
        "~/Developer",
        "~/.gbrain",
        "~/.memex",
        "~/.openspec",
        "~/.local/share/openspec",
        "~/.semgrep",
        "~/Library/Caches/",
        "~/Data/Memex",
        "~/Data/Sessions",
        "~/Data/SessionVersions",
        "~/Data/Transcripts",
        "~/Data/Plans",
        "~/Data/ToolCalls",
        "~/Data/PromptEnvelopes",
        "~/Data/Captures",
        "~/Data/State",
        "~/Data/Imports",
        "~/Data/Backups",
        "~/Data/Telemetry",
        "~/Data/Claude"
      ],
      "denyWrite": [
        "~/Library/Caches/at.obdev.littlesnitch",
        "~/Library/Caches/at.obdev.littlesnitch.softwareupdate",
        "~/Library/Caches/Proton AG",
        "~/Library/Caches/PassKit",
        "~/Library/Caches/CloudKit",
        "~/Library/Caches/Steam"
      ],
      "denyRead": [
        "~/.claude.json",
        "~/.ssh",
        "~/.aws",
        "~/.azure",
        "~/.gnupg",
        "~/.kube",
        "~/.config/gh",
        "~/.config/gcloud",
        "~/.git-credentials",
        "~/Library/Keychains",
        "~/.npmrc",
        "~/.npm",
        "~/.pypirc",
        "~/.gem/credentials",
        "~/.cargo/credentials.toml",
        "~/.config/containers",
        "~/.docker/config.json",
        "~/.netrc",
        "~/.config/op",
        "~/.password-store",
        "~/Library/Application Support/mkcert/rootCA-key.pem",
        "/Volumes/Keyvault",
        "/Volumes/.timemachine",
        "/Volumes/com.apple.TimeMachine.localsnapshots"
      ]
    },
    "excludedCommands": [
      "docker *",
      "gh *",
      "rtk gh *",
      "glab *",
      "rtk glab *",
      "git *",
      "rtk git *",
      "brew *",
      "rtk brew *",
      "container *",
      "rtk container *",
      "prlctl *",
      "rtk prlctl *",
      "orb *",
      "rtk orb *",
      "orbctl *",
      "rtk orbctl *",
      "jj *",
      "rtk jj *",
      {{- /*
      Agent CLIs are not excluded: an excluded child agent runs with full
      user rights and none of this policy. Only the rune forms that cannot
      work inside the sandbox are excluded (2026-10-24). `run` and `proof run`
      start harnesses, and a child inherits this sandbox: codex fails its
      app-server, grok fails its own Seatbelt sandbox, and agy cannot read its
      keychain login. `launch` starts an interactive harness. `sign` needs gpg
      and ~/.gnupg. `install`, `deploy`, `clean`, and `repair` write the
      harness homes. Every other rune command runs sandboxed, so
      autoAllowBashIfSandboxed lets it through without a prompt (probed: spec
      validate, config path, proof --check, and --version). A direct `codex` or
      `grok` call fails its nested sandbox here and comes back as an
      unsandboxed retry, which goes through the permission prompt. Docker
      keeps its exclusion for OrbStack work, but its sockets are closed to
      sandboxed commands and `docker` asks first. Each rune form also has an
      `rtk` twin, because the UseEfficientCLI rule makes models write `rtk rune
      run`, which ran sandboxed and came back as an unsandboxed retry prompt
      (54 such calls on 2026-10-24).
      */}}
      "rune run *",
      "rtk rune run *",
      "rune --json run *",
      "rtk rune --json run *",
      "rune launch *",
      "rtk rune launch *",
      "rune proof run *",
      "rtk rune proof run *",
      "rune --json proof run *",
      "rtk rune --json proof run *",
      "rune sign",
      "rtk rune sign",
      "rune sign *",
      "rtk rune sign *",
      "rune install",
      "rtk rune install",
      "rune install *",
      "rtk rune install *",
      "rune deploy",
      "rtk rune deploy",
      "rune deploy *",
      "rtk rune deploy *",
      "rune clean",
      "rtk rune clean",
      "rune clean *",
      "rtk rune clean *",
      "rune repair",
      "rtk rune repair",
      "rune repair *",
      "rtk rune repair *",
      "zed *",
      "open -a Zed *",
      {{- /*
      Only the first token of a command line is matched. A leading `cd dir
      &&` is tolerated, except for the guarded `jj push`, whose alias reads
      the shell cwd: there `cd` is its own call. A pipe, a redirect, a loop,
      or `$( )` around an excluded command runs it sandboxed, and it dies
      with -26276, -60008, or EPERM (probed again 2026-10-19 with `cd *` and
      `rtk head *` listed: `cd dir && gh auth status | rtk head` read the
      keychain token as invalid, bare `gh auth status` did not, so those
      entries were removed). A chain that needs the keychain goes in a
      script under the workshop's docs/specs, which the two entries below
      exclude by their first token; the receipt and seat scripts live there.
      */}}
      "sh {{ .chezmoi.homeDir }}/Agents/runedeck/docs/specs/*",
      "bash {{ .chezmoi.homeDir }}/Agents/runedeck/docs/specs/*"
    ]
  },
  "effortLevel": "high",
  "modelSettings": {
    "claude-fable-5": {
      "effortLevel": "xhigh"
    },
    "claude-fable-5-1": {
      "effortLevel": "xhigh"
    },
    "claude-opus-5-5": {
      "effortLevel": "xhigh"
    }
  },
  "remoteControlAtStartup": true,
  "tui": "fullscreen",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "theme": "custom:nord",
  "verbose": true,
  "preferredNotifChannel": "auto",
  "autoCompactEnabled": true,
  "switchModelsOnFlag": false,
  "teammateMode": "in-process",
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  {{- /* Auto-review policy is shared: edit .chezmoidata/harness/automode.json, not this block. */ -}}
  {{- $auto := .automode -}}
  {{- $mine := .automode.append.claude }}
  "autoMode": {{ dict
      "allow" (concat (list "$defaults") $auto.allow $mine.allow)
      "soft_deny" (concat (list "$defaults") $auto.soft_deny $mine.soft_deny)
      "hard_deny" (concat (list "$defaults") $auto.hard_deny $mine.hard_deny)
      "environment" (concat (list "$defaults") $auto.environment $mine.environment)
      "classifyAllShell" true
    | toPrettyJson | replace "@GITLAB_HOST@" .private.gitlab_host }},
  "voiceEnabled": true,
  "maxSkillDescriptionChars": 2048
}
DESIRED
)
# Path migration (2026-10-18, PROV-0025): the hook dispatcher moved from
# ~/.sd/hook to ~/.config/just/hook. The live hooks block keeps the old
# path until rune rewrites it, so every command string is repointed
# here. Remove this once no live settings carry the old path.
printf '%s\n' "$desired" | jq --argjson live "$live" '
    . + {hooks: (($live.hooks // {})
        | walk(if type == "string" then sub("/\\.sd/hook "; "/.config/just/hook ") else . end))}
    + ($live | {model, outputStyle} | with_entries(select(.value != null)))'
