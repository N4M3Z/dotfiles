{{- $harness := .harness.claude -}}
#!/bin/sh
# A modify script: chezmoi hands the live settings.json on stdin and takes
# the new file from stdout. Everything but `hooks` comes from the template
# below; `hooks` is kept from the live file as it is, because rune owns
# that block (cli change harness-hook-dispatch, DOT-0007): `rune hook
# install` writes one dispatcher entry per event and keeps every foreign
# entry. Nothing here registers a hook, so a chezmoi apply never undoes
# what rune wrote and never resurrects the retired `sd hook` parts.
# `model` and `outputStyle` are also kept from the live file: /model and
# /output-style write them per machine, and the template sets neither.
set -eu
live=$(cat)
[ -n "$live" ] || live='{}'
desired=$(cat <<'DESIRED'
{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "cleanupPeriodDays": 36500,
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "BASH_DEFAULT_TIMEOUT_MS": "180000",
    "BASH_MAX_TIMEOUT_MS": "900000",
    "CLAUDE_CODE_SUBPROCESS_ENV_SCRUB": "1",
    "DATABASE_URL": "postgresql://localhost:5432/memex",
    "CLAUDE_CODE_ENABLE_TELEMETRY": "1",
    "CLAUDE_CODE_ENHANCED_TELEMETRY_BETA": "1",
    "OTEL_METRICS_EXPORTER": "otlp",
    "OTEL_LOGS_EXPORTER": "otlp",
    "OTEL_TRACES_EXPORTER": "none",
    "OTEL_EXPORTER_OTLP_PROTOCOL": "http/protobuf",
    "OTEL_EXPORTER_OTLP_ENDPOINT": "http://localhost:4318",
    "OTEL_EXPORTER_OTLP_METRICS_TEMPORALITY_PREFERENCE": "cumulative",
    "OTEL_METRIC_EXPORT_INTERVAL": "60000",
    "OTEL_LOG_USER_PROMPTS": "1",
    "OTEL_LOG_TOOL_DETAILS": "1",
    "OTEL_METRICS_INCLUDE_SESSION_ID": "false",
    "GITLAB_HOST": "{{ .private.gitlab_host }}"
  },
  "permissions": {{ $harness.permissions | toPrettyJson }},
  "attribution": {
    "commit": "Co-Authored-By: Martin Zeman <N4M3Z@users.noreply.github.com>"
  },
  "enableAllProjectMcpServers": false,
  "statusLine": {
    "type": "command",
    "command": "{{ .chezmoi.homeDir }}/.bun/bin/ccline",
    "padding": 0
  },
  "enabledPlugins": {
    "warp@claude-code-warp": false,
    "superwhisper@superwhisper": false,
    "terminal-browser@terminal-browser": true,
    "filetree@n4m3z": true,
    "review@runedeck": true,
    "spec@runedeck": true,
    "proof@runedeck": true,
    "sign@runedeck": true,
    "draft@runedeck": true,
    "hook@runedeck": true,
    "council@runedeck": true,
    "tasks@runedeck": true,
    "jj@runedeck": true,
    "replay@runedeck": true,
    "doc-review@runedeck": true,
    "flightdeck@runedeck": true,
    "vale-lsp@runedeck": true,
    "blast-radius@runedeck": true,
    "cc-plugin-you-should-know@builtin": true
  },
  "extraKnownMarketplaces": {
    "claude-code-warp": {
      "source": {
        "source": "github",
        "repo": "warpdotdev/claude-code-warp"
      }
    },
    "superwhisper": {
      "source": {
        "source": "github",
        "repo": "superultrainc/superwhisper-claude-code"
      }
    },
    "terminal-browser": {
      "source": {
        "source": "github",
        "repo": "zenbu-labs/terminal-browser"
      }
    },
    "n4m3z": {
      "source": {
        "source": "directory",
        "path": "{{ .chezmoi.homeDir }}/Developer/N4M3Z/filetree"
      }
    },
    "runedeck": {
      "source": {
        "source": "directory",
        "path": "{{ .chezmoi.homeDir }}/Developer/runedeck/mods"
      }
    }
  },
  {{- /*
  allowUnsandboxedCommands stays true on purpose (2026-09-22). The sandbox
  denies what the signing and forge ceremony needs: the YubiKey pinentry and
  gpg-agent for `jj sign`, the keychain for `gh` over TLS, a nested sandbox
  for `grok` and `codex`, and the jj lock files of a colocated repo. `trash`
  is not on that list: ~/.local/bin/trash writes the FreeDesktop layout under
  ~/.local/share/Trash, which allowWrite covers, so it runs sandboxed. With this false, every such step fails with -26276 or
  "Operation not permitted" and the owner runs it by hand. With it true a
  session may ask for one command outside the sandbox; the request still goes
  through the permission prompt. The `Bash(dangerouslyDisableSandbox:true)`
  allow rule below matches command text, not the request flag, so it grants
  nothing on its own. Known limit: a session that lies in the request text
  is not stopped here. dcg and the permission prompt are the guard.
  */}}
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": true,
    "autoAllowBashIfSandboxed": true,
    "network": {
      "allowedDomains": [
        "github.com",
        "*.github.com",
        "raw.githubusercontent.com",
        "objects.githubusercontent.com",
        "pkg-containers.githubusercontent.com",
        "registry.npmjs.org",
        "crates.io",
        "static.crates.io",
        "index.crates.io",
        "formulae.brew.sh",
        "ghcr.io",
        "pypi.org",
        "*.pypi.org",
        "files.pythonhosted.org",
        "semgrep.dev",
        "*.semgrep.dev",
        "browserbase.com",
        "*.browserbase.com",
        "{{ .private.gitlab_host }}",
        "localhost",
        "127.0.0.1"
      ],
      "allowUnixSockets": [
        "/tmp/.s.PGSQL.5432",
        "~/.obsidian-cli.sock",
        "~/.gnupg/S.gpg-agent",
        "~/.gnupg/S.dirmngr",
        "~/.orbstack/run/docker.sock",
        "/var/run/docker.sock"
      ],
      "allowLocalBinding": true
    },
    "filesystem": {
      "allowWrite": [
        "~/Agents",
        "~/.cache/uv",
        "~/.cache/act",
        "~/.cache/prek",
        "~/.local/share/Trash",
        "/tmp/claude",
        "/var/folders",
        "~/Atlas",
        "~/Developer",
        "~/.gbrain",
        "~/.memex",
        "~/.openspec",
        "~/.local/share/openspec",
        "~/.semgrep",
        "~/Library/Caches/",
        "/opt/homebrew",
        "~/Data/Memex",
        "~/Data/Sessions",
        "~/Data/SessionVersions",
        "~/Data/Transcripts",
        "~/Data/Plans",
        "~/Data/ToolCalls",
        "~/Data/PromptEnvelopes",
        "~/Data/Captures",
        "~/Data/State",
        "~/Data/Imports",
        "~/Data/Backups",
        "~/Data/Telemetry",
        "~/Data/Claude"
      ],
      "denyWrite": [
        "~/Library/Caches/at.obdev.littlesnitch",
        "~/Library/Caches/at.obdev.littlesnitch.softwareupdate",
        "~/Library/Caches/Proton AG",
        "~/Library/Caches/PassKit",
        "~/Library/Caches/CloudKit",
        "~/Library/Caches/Steam"
      ],
      "denyRead": [
        "~/.claude.json",
        "~/.ssh",
        "~/.aws",
        "~/.azure",
        "~/.gnupg",
        "~/.kube",
        "~/.config/gh",
        "~/.config/gcloud",
        "~/.git-credentials",
        "~/Library/Keychains",
        "~/.npmrc",
        "~/.npm",
        "~/.pypirc",
        "~/.gem/credentials",
        "~/.cargo/credentials.toml",
        "~/.config/containers",
        "~/.docker/config.json",
        "~/.netrc",
        "~/.config/op",
        "~/.password-store",
        "/Volumes/Keyvault",
        "/Volumes/.timemachine",
        "/Volumes/com.apple.TimeMachine.localsnapshots"
      ]
    },
    "excludedCommands": [
      "docker *",
      "gh *",
      "rtk gh *",
      "glab *",
      "rtk glab *",
      "git *",
      "rtk git *",
      "brew *",
      "rtk brew *",
      "container *",
      "rtk container *",
      "prlctl *",
      "rtk prlctl *",
      "orb *",
      "rtk orb *",
      "orbctl *",
      "rtk orbctl *",
      "jj *",
      "rtk jj *",
      "rune *",
      "codex *",
      "claude *",
      "opencode *",
      "agy *",
      "grok *",
      "pi *",
      "zed *",
      "open -a Zed *"
    ]
  },
  "effortLevel": "high",
  "modelSettings": {
    "claude-fable-5": {
      "effortLevel": "xhigh"
    },
    "claude-fable-5-1": {
      "effortLevel": "xhigh"
    },
    "claude-opus-5-5": {
      "effortLevel": "xhigh"
    }
  },
  "remoteControlAtStartup": true,
  "tui": "fullscreen",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "theme": "custom:nord",
  "verbose": true,
  "preferredNotifChannel": "auto",
  "autoCompactEnabled": true,
  "switchModelsOnFlag": false,
  "teammateMode": "in-process",
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  {{- /* Auto-review policy is shared: edit .chezmoidata/harness/automode.json, not this block. */ -}}
  {{- $auto := .automode -}}
  {{- $mine := .automode.append.claude }}
  "autoMode": {{ dict
      "allow" (concat (list "$defaults") $auto.allow $mine.allow)
      "soft_deny" (concat (list "$defaults") $auto.soft_deny $mine.soft_deny)
      "hard_deny" (concat (list "$defaults") $auto.hard_deny $mine.hard_deny)
      "environment" (concat (list "$defaults") $auto.environment $mine.environment)
    | toPrettyJson | replace "@GITLAB_HOST@" .private.gitlab_host }},
  "voiceEnabled": true,
  "maxSkillDescriptionChars": 2048
}
DESIRED
)
printf '%s\n' "$desired" | jq --argjson live "$live" \
    '. + {hooks: ($live.hooks // {})} + ($live | {model, outputStyle} | with_entries(select(.value != null)))'
