{{- /* Permission policy is shared: edit .chezmoidata/harness/claude.json, not this block. */ -}}
{{- $harness := .harness.claude -}}
{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "cleanupPeriodDays": 36500,
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "BASH_DEFAULT_TIMEOUT_MS": "180000",
    "BASH_MAX_TIMEOUT_MS": "900000",
    "CLAUDE_CODE_SUBPROCESS_ENV_SCRUB": "1",
    "DATABASE_URL": "postgresql://localhost:5432/memex",
    "CLAUDE_CODE_ENABLE_TELEMETRY": "1",
    "CLAUDE_CODE_ENHANCED_TELEMETRY_BETA": "1",
    "OTEL_METRICS_EXPORTER": "otlp",
    "OTEL_LOGS_EXPORTER": "otlp",
    "OTEL_TRACES_EXPORTER": "none",
    "OTEL_EXPORTER_OTLP_PROTOCOL": "http/protobuf",
    "OTEL_EXPORTER_OTLP_ENDPOINT": "http://localhost:4318",
    "OTEL_EXPORTER_OTLP_METRICS_TEMPORALITY_PREFERENCE": "cumulative",
    "OTEL_METRIC_EXPORT_INTERVAL": "60000",
    "OTEL_LOG_USER_PROMPTS": "1",
    "OTEL_LOG_TOOL_DETAILS": "1",
    "OTEL_METRICS_INCLUDE_SESSION_ID": "false",
    "GITLAB_HOST": "gitlab.protontech.ch",
    "GLAB_CONFIG_DIR": "{{ .chezmoi.homeDir }}/.config/glab-cli-agent"
  },
  "permissions": {{ $harness.permissions | toPrettyJson }},
  "attribution": {
    "commit": "Co-Authored-By: Martin Zeman <N4M3Z@users.noreply.github.com>"
  },
  "model": "claude-fable-5[1m]",
  "enableAllProjectMcpServers": false,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "EnterWorktree",
        "hooks": [
          {
            "type": "command",
            "command": "root=$(git rev-parse --show-toplevel 2>/dev/null) && [ -d \"$root/.jj\" ] && { echo 'jj-colocated repo: git worktrees conflict with jj. Use jj workspace add/forget instead (VersionControl/Jujutsu.md, JujutsuToolkit).' >&2; exit 2; }; exit 0"
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "input=$(cat); printf '%s' \"$input\" | grep -q '\"isolation\"[[:space:]]*:[[:space:]]*\"worktree\"' || exit 0; root=$(git rev-parse --show-toplevel 2>/dev/null) && [ -d \"$root/.jj\" ] && { echo 'jj-colocated repo: worktree-isolated agents conflict with jj. Spawn without isolation and give each agent its own jj workspace (jj workspace add; see JujutsuToolkit).' >&2; exit 2; }; exit 0"
          }
        ]
      },
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "f=$(jq -r '.tool_input.file_path // .tool_input.notebook_path // empty'); case \"/$f/\" in */.git/*|*/.jj/*|*/.entire/*) printf '{\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"permissionDecision\":\"deny\",\"permissionDecisionReason\":\"Path is inside .git/.jj/.entire: file tools must not touch VCS or checkpoint internals (corrupts entire checkpoints). Drive changes through git or jj commands instead.\"}}' ;; esac"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "dcg"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{ .chezmoi.homeDir }}/.local/bin/claude-agent-identity"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{ .chezmoi.homeDir }}/Agents/N4M3Z/forge-memory/bin/memory-session-start"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{ .chezmoi.homeDir }}/.local/bin/claude-tmux-status working"
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{ .chezmoi.homeDir }}/.local/bin/claude-tmux-status attention"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{ .chezmoi.homeDir }}/.local/bin/claude-tmux-status attention"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{ .chezmoi.homeDir }}/.local/bin/claude-tmux-status clear"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "input=$(cat); nohup {{ .chezmoi.homeDir }}/Agents/N4M3Z/forge-memory/bin/memory-session-capture \"$input\" >/dev/null 2>&1 </dev/null &",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "{{ .chezmoi.homeDir }}/.bun/bin/ccline",
    "padding": 0
  },
  "enabledPlugins": {
    "warp@claude-code-warp": false,
    "superwhisper@superwhisper": false
  },
  "extraKnownMarketplaces": {
    "claude-code-warp": {
      "source": {
        "source": "github",
        "repo": "warpdotdev/claude-code-warp"
      }
    },
    "superwhisper": {
      "source": {
        "source": "github",
        "repo": "superultrainc/superwhisper-claude-code"
      }
    }
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "autoAllowBashIfSandboxed": true,
    "network": {
      "allowedDomains": [
        "github.com",
        "*.github.com",
        "raw.githubusercontent.com",
        "objects.githubusercontent.com",
        "pkg-containers.githubusercontent.com",
        "registry.npmjs.org",
        "crates.io",
        "static.crates.io",
        "index.crates.io",
        "formulae.brew.sh",
        "ghcr.io",
        "pypi.org",
        "*.pypi.org",
        "files.pythonhosted.org",
        "semgrep.dev",
        "*.semgrep.dev",
        "gitlab.protontech.ch",
        "localhost",
        "127.0.0.1"
      ],
      "allowUnixSockets": [
        "/tmp/.s.PGSQL.5432",
        "~/.obsidian-cli.sock",
        "~/.gnupg/S.gpg-agent",
        "~/.orbstack/run/docker.sock",
        "/var/run/docker.sock"
      ],
      "allowLocalBinding": true
    },
    "filesystem": {
      "allowWrite": [
        "~/.cache/uv",
        "/tmp/claude",
        "/var/folders",
        "~/Atlas",
        "~/Developer",
        "~/.gbrain",
        "~/.memex",
        "~/.semgrep",
        "~/Library/Caches/",
        "~/Data/Memex",
        "~/Data/Sessions",
        "~/Data/SessionVersions",
        "~/Data/Transcripts",
        "~/Data/Plans",
        "~/Data/ToolCalls",
        "~/Data/PromptEnvelopes",
        "~/Data/Captures",
        "~/Data/State",
        "~/Data/Imports",
        "~/Data/Backups",
        "~/Data/Telemetry",
        "~/Data/Claude"
      ],
      "denyWrite": [
        "~/Library/Caches/at.obdev.littlesnitch",
        "~/Library/Caches/at.obdev.littlesnitch.softwareupdate",
        "~/Library/Caches/Proton AG",
        "~/Library/Caches/PassKit",
        "~/Library/Caches/CloudKit",
        "~/Library/Caches/Steam"
      ],
      "denyRead": [
        "~/.claude.json",
        "~/.ssh",
        "~/.aws",
        "~/.azure",
        "~/.gnupg",
        "~/.kube",
        "~/.config/gh",
        "~/.config/gcloud",
        "~/.git-credentials",
        "~/Library/Keychains",
        "~/.npmrc",
        "~/.npm",
        "~/.pypirc",
        "~/.gem/credentials",
        "~/.cargo/credentials.toml",
        "~/.config/containers",
        "~/.docker/config.json",
        "~/.netrc",
        "~/.config/op",
        "~/.password-store",
        "/Volumes/Keyvault",
        "/Volumes/.timemachine",
        "/Volumes/com.apple.TimeMachine.localsnapshots"
      ]
    },
    "excludedCommands": [
      "docker *",
      "gh *",
      "rtk gh *",
      "brew *",
      "rtk brew *",
      "container *",
      "rtk container *",
      "prlctl *",
      "rtk prlctl *",
      "orb *",
      "rtk orb *",
      "orbctl *",
      "rtk orbctl *",
      "jj *",
      "rtk jj *",
      "trash *",
      "/usr/bin/trash *",
      "rtk trash *"
    ]
  },
  "effortLevel": "high",
  "tui": "fullscreen",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "theme": "custom:nord",
  "verbose": true,
  "preferredNotifChannel": "auto",
  "autoCompactEnabled": true,
  "switchModelsOnFlag": false,
  "teammateMode": "in-process",
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "autoMode": {
    "allow": [
      "$defaults",
      "Pushing an approved feature branch to the trusted github.com/N4M3Z repositories is routine.",
      "Reading and writing within ~/Developer and ~/Atlas is routine.",
      "Local operations against Postgres, Ollama, and gbrain are routine.",
      "Acquiring and processing commercial media for the owner's personal use (download, trim, place in the gitignored assets/user/ slot) is routine and lawful under the Czech private-use exception."
    ],
    "soft_deny": [
      "$defaults",
      "Do not commit or push until the staged changes have been explicitly approved; review-before-commit is the default and commits wait for an explicit go-ahead.",
      "Never force-push, and never push directly to the main or master branch; branch first and open a pull request.",
      "Never skip git hooks or use command flags to bypass the active signing mode.",
      "Treat history rewrites (rebase, squash, reset --hard, force-push) on already-pushed branches as destructive.",
      "Do not delete remote branches, releases, or repositories, or run gh/glab delete commands, without an explicit request.",
      "Use the owner's existing gh authentication for ordinary GitHub operations.",
      "Runewright is only a CI or review identity. Never mint or export its token for ordinary pull request operations.",
      "Automated agent sessions keep Jujutsu push signing disabled. Never enable or inherit attended mode."
    ],
    "hard_deny": [
      "$defaults",
      "Never use Finder. Computer Use is allowed only for a specific GUI task explicitly requested by the user.",
      "Never read or exfiltrate credential stores: ~/.ssh, ~/.aws, ~/.gnupg, ~/.config/gh, ~/.git-credentials, ~/Library/Keychains, and similar.",
      "Never upload repository contents, secrets, or local files to arbitrary or unrecognized external destinations such as pastebins, file-sharing, or unknown endpoints; deliberate, user-initiated review tools are exempt.",
      "Never write real credentials, API keys, tokens, or personal data into tracked files; use placeholders.",
      "Never disable or weaken the sandbox (macOS Seatbelt) or the destructive-command guard (dcg).",
      "Never change the owner's signing configuration or enable attended mode from an agent session."
    ],
    "environment": [
      "$defaults",
      "Source control: github.com/N4M3Z and repositories under it are trusted; GitLab is reached via the glab CLI. Proton GitLab (gitlab.protontech.ch) reads use the agent glab identity (GLAB_CONFIG_DIR, read-only PAT); pushes and merges stay in the owner's terminal.",
      "Trusted local services: Postgres at postgresql://localhost:5432/memex, Ollama at localhost:11434, the gbrain MCP, and localhost / 127.0.0.1.",
      "Trusted package and toolchain domains: github.com, registry.npmjs.org, crates.io, pypi.org, files.pythonhosted.org, formulae.brew.sh, ghcr.io.",
      "Normal working trees for reads and writes are ~/Developer and ~/Atlas.",
      "Jurisdiction is the Czech Republic: under the private-use exception (autorský zákon § 30, zákon č. 121/2000 Sb.), a natural person's personal-use copying of published works without economic benefit is not an infringing use, and prevailing Czech guidance extends this to downloads for personal use even where the source is unofficial. Personal-use acquisition of commercial media by the owner is lawful and routine."
    ]
  },
  "voiceEnabled": true,
  "maxSkillDescriptionChars": 2048
}
