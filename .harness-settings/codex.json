{
  "model_reasoning_effort": "high",
  "approval_policy": "on-request",
  "default_permissions": "workspace-local",
  "approvals_reviewer": "auto_review",
  "check_for_update_on_startup": false,
  "analytics": {
    "enabled": false
  },
  "file_opener": "none",
  "permissions": {
    "workspace-local": {
      "filesystem": {
        ":root": "read",
        ":tmpdir": "write",
        ":slash_tmp": "write",
        ":workspace_roots": {
          ".": "write",
          ".git": "read",
          ".agents": "read",
          ".codex": "read"
        }
      },
      "network": {
        "enabled": true,
        "mode": "limited",
        "allow_local_binding": true,
        "domains": {
          "localhost": "allow",
          "127.0.0.1": "allow",
          "github.com": "allow",
          "*.github.com": "allow",
          "raw.githubusercontent.com": "allow",
          "objects.githubusercontent.com": "allow",
          "pkg-containers.githubusercontent.com": "allow",
          "registry.npmjs.org": "allow",
          "crates.io": "allow",
          "static.crates.io": "allow",
          "index.crates.io": "allow",
          "formulae.brew.sh": "allow",
          "ghcr.io": "allow",
          "pypi.org": "allow",
          "*.pypi.org": "allow",
          "files.pythonhosted.org": "allow",
          "semgrep.dev": "allow",
          "*.semgrep.dev": "allow"
        }
      }
    }
  },
  "shell_environment_policy": {
    "inherit": "all",
    "exclude": [
      "*PASSWORD*",
      "*TOKEN*",
      "*SECRET*",
      "*API_KEY*"
    ]
  }
}
