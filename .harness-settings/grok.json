{
  "sandbox": {
    "profile": "workspace",
    "auto_allow_bash": false
  },
  "tools": {
    "respect_gitignore": true
  },
  "session": {
    "load_envrc": false
  },
  "cli": {
    "auto_update": false
  },
  "permission": {
    "deny": [
      "Bash(open *Finder*)",
      "Bash(osascript *Finder*)",
      "Read(~/.ssh/**)",
      "Edit(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.azure/**)",
      "Read(~/.config/gcloud/**)",
      "Read(~/.netrc)",
      "Read(~/.gnupg/**)",
      "Read(~/.kube/**)",
      "Read(~/.docker/config.json)",
      "Read(~/.config/gh/**)",
      "Read(~/.git-credentials)",
      "Read(~/.npmrc)",
      "Read(~/.pypirc)",
      "Read(~/.gem/credentials)",
      "Read(~/Library/Keychains/**)",
      "Read(~/.password-store/**)",
      "Edit(~/.bashrc)",
      "Edit(~/.zshrc)",
      "Edit(~/.bash_profile)",
      "Edit(~/.zprofile)",
      "Edit(~/.profile)"
    ]
  }
}
