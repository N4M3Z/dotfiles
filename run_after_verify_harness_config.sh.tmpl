#!/usr/bin/env bash
# Prove each harness still loads its config after apply. A modify_ template can
# emit a file the app rejects (a glob in a write grant stopped the Codex desktop
# app at sign-in once), and the app reports that as a network error hours later.
# Failing here turns that into a failed `chezmoi apply` with the parser's own
# message. Each probe is skipped when its binary is absent.
#
# codex: `codex mcp list` exits non-zero and prints the `Caused by` line on a
# parse error; `codex doctor` exits 0 and buries the same failure in its report.
# claude: `claude doctor` reads settings with no trust prompt.
# grok: `grok inspect --json` exits 0 even when config.toml does not parse. It
# marks that config layer with the note "parse error" and lists unknown keys
# under configWarnings, so the probe reads both. GROK_SANDBOX=off stops inspect
# from applying the sandbox profile, which fails when apply itself runs inside
# an agent sandbox. tests/test-grok-sandbox.sh checks the profiles instead.
# muse: Muse Code refuses a permission profile with a rule it cannot enforce,
# and then refuses to start. `muse exec` with the echo provider makes no model
# call and prints that refusal, an unknown key, or a bad hook at startup. Inside
# an agent sandbox that hides ~/.gnupg, Muse cannot resolve the gpg-agent socket
# rule. Only that exact message with exit 1 can be skipped there.
set -o pipefail

status=0

if command -v codex >/dev/null 2>&1; then
    if ! output=$(codex mcp list 2>&1); then
        echo "fail:harness-config (codex config does not load)" >&2
        printf '%s\n' "$output" | grep -A2 'Caused by' >&2
        status=1
    fi
fi

if command -v claude >/dev/null 2>&1; then
    if ! claude doctor >/dev/null 2>&1; then
        echo "fail:harness-config (claude doctor reports a problem; run it for detail)" >&2
        status=1
    fi
fi

if command -v grok >/dev/null 2>&1; then
    if ! output=$(GROK_SANDBOX=off grok inspect --json 2>/dev/null); then
        echo "fail:harness-config (grok inspect fails; run it for detail)" >&2
        status=1
    else
        if ! problems=$(printf '%s' "$output" | jq -rs '
            if length != 1 or (.[0] | type) != "object"
            then error("expected one JSON object") else .[0] end
            | ((.configSources.layers // [])[] | select(.note == "parse error") | "\(.path): parse error"),
              ((.configWarnings // [])[] | "\(.path): \(.reason)")'); then
            echo "fail:harness-config (cannot parse grok inspect output)" >&2
            status=1
        elif [ -n "$problems" ]; then
            echo "fail:harness-config (grok config has problems)" >&2
            printf '%s\n' "$problems" >&2
            status=1
        fi
    fi
fi

if command -v muse >/dev/null 2>&1; then
    probe_dir=$(mktemp -d "${TMPDIR:-/tmp}/muse-verify.XXXXXX")
    output=$(cd "$probe_dir" && muse exec --provider echo --no-session-log --disable-reminders probe 2>&1)
    code=$?
    command rm -rf "$probe_dir"
    problems=$(printf '%s\n' "$output" \
        | grep -E 'ermission profile|unknown (key|field)|refusing run|Hooks: .*warning|UnsupportedEvent|MalformedConfig')
    # Muse quotes the path in literal backticks.
    # shellcheck disable=SC2016
    socket=$(printf '%s\n' "$problems" | sed -n 's/^Named permission profiles are unavailable: unresolvable Unix socket path `\(.*\)`\.$/\1/p')
    socket_problem="Named permission profiles are unavailable: unresolvable Unix socket path \`${socket}\`."
    if [ "$code" -eq 1 ] && [ -n "$socket" ] && [ "$output" = "$socket_problem" ] \
        && [ ! -r "$(dirname "$socket")" ]; then
        echo "skip:harness-config (muse socket folder is unreadable in this sandbox)" >&2
    elif [ "$code" -ne 0 ] || [ -n "$problems" ]; then
        echo "fail:harness-config (muse does not load its settings)" >&2
        printf '%s\n' "${problems:-$output}" | tail -n 5 >&2
        status=1
    fi
fi

exit "$status"
