{{- /* chezmoi:modify-template */ -}}
{{- $current := dict -}}
{{- if trim .chezmoi.stdin -}}
{{- $current = fromJson .chezmoi.stdin -}}
{{- end -}}
{{- if not (kindIs "map" $current) -}}
{{- fail "Expected an Obsidian JSON object; no settings were changed." -}}
{{- end -}}
{{- range $command := list
    "excalidraw-autocreate-newtab"
    "New Markdown Card"
    "Toggle Library"
    "Copy Selection for Agent"
    "Draft Markdown with Source"
    "Slideshow"
    "Downloaded/Mindmap Builder"
    "Downloaded/Select Elements of Type"
    "universal-add-file"
    "insert-link-to-element"
    "frame-settings"
    "excalidraw-open-sidepanel"
-}}
{{- $current = setValueAtPath (list (printf "obsidian-excalidraw-plugin:%s" $command)) (list) $current -}}
{{- end -}}
{{- $current = setValueAtPath (list "pdf-plus:copy-link-to-selection") (fromJson `[{"modifiers": ["Mod", "Shift"], "key": "K"}]`) $current -}}
{{ $current | toPrettyJson }}
