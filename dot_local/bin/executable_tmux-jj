#!/bin/sh
# Status-bar jj segment: "jj <bookmark-or-changeid> *" (* = working copy has
# changes) in a Jujutsu repo, nothing otherwise. --ignore-working-copy skips
# the snapshot on every status refresh (no op-log spam, no lock races with
# concurrent jj sessions); the * therefore reflects the last real jj command.

dir=${1:-$PWD}
jj -R "$dir" root >/dev/null 2>&1 || exit 0

out=$(jj -R "$dir" --ignore-working-copy log -r @ --no-graph --color never \
    -T 'separate(" ", if(bookmarks, bookmarks, change_id.shortest(8)), if(empty, "", "*"))' 2>/dev/null)
[ -n "$out" ] && printf 'jj %s' "$out"
