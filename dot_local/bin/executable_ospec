#!/bin/sh
# ospec: run the openspec CLI against the current repository's docs/ tree.
# The CLI hard-codes the openspec/ directory name, so a shadow root under
# ~/.openspec/<repo> holds one symlink (openspec -> <repo>/docs) and the
# repository itself stays clean. docs/ is canonical for rune repositories.
set -eu

root=$(jj root 2>/dev/null || git rev-parse --show-toplevel 2>/dev/null) \
    || { echo "ospec: not inside a repository" >&2; exit 1; }
[ -d "$root/docs" ] || { echo "ospec: $root/docs does not exist" >&2; exit 1; }

shadow="$HOME/.openspec/$(basename "$root")"
mkdir -p "$shadow"
ln -sfn "$root/docs" "$shadow/openspec"

cd "$shadow"
OPENSPEC_TELEMETRY=0 exec openspec "$@"
