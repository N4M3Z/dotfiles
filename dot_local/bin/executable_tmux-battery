#!/bin/sh
# Status-bar battery segment: "chg 84%" on AC, "bat 84%" on battery, nothing
# if pmset reports no battery (desktop). macOS-only (pmset).

raw=$(pmset -g batt 2>/dev/null) || exit 0
pct=$(printf '%s' "$raw" | grep -o '[0-9]\{1,3\}%' | head -1 | tr -d '%')
[ -n "$pct" ] || exit 0

case "$raw" in
    *"AC Power"*) printf 'chg %s%%' "$pct" ;;
    *)            printf 'bat %s%%' "$pct" ;;
esac
