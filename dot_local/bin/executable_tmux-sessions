#!/bin/sh
# Pick a live session by display name, then switch by tmux's stable session ID.
# Names can contain dots or colons, which tmux target parsing treats as pane or
# window separators even though those characters are valid in session names.

list=$(tmux list-sessions -F '#{session_id} #{session_name}' 2>/dev/null) || exit 0
[ -n "$list" ] || { tmux display-message 'no tmux sessions'; exit 0; }

selected=$(printf '%s\n' "$list" | fzf --reverse --with-nth=2.. --header 'tmux sessions') || exit 0
session_id=${selected%% *}
[ -n "$session_id" ] || exit 0
exec tmux switch-client -t "$session_id"
